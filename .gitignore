# ---- Build artifacts (compiler output) ----
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib
*.exe
*.outs
*.exp
*.dll.a
*.opus
*.h264

# ignore ANY build directory
/build/
build*/
build/


# ---- Core CMake files ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
# CMake File API artifacts (.cmake/api/... query/reply jsons, regenerated on every configure)
.cmake/

# ---- Ninja generator ----
build.ninja
rules.ninja
.ninja_log
.ninja_deps
.ninja_lock
# Ninja temporary files
*.tmp*

# ---- Makefile generator ----
Makefile

# ---- Optional: CTest output ----
Testing/

#ide folders
.idea/


.vscode/
*.swp
*.swo
*~

# ---- CMake presets (user-specific) ----
CMakeUserPresets.json

# ---- Package managers ----
vcpkg_installed/
conan/

# ---- Compilation database (clangd, etc.) ----
compile_commands.json

# ---- Debug ----
*.dSYM/
*.pdb
*.ilk

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Project notes (local, not tracked) ----
notes/
buildresult/
/proposals/

# gradle
.gradle

# ---- headless node bundle (generated by nodejs-client/build-node.py, same idea as client.html) ----
client-source-code/client-development/mobile/nodejs-client/bundle.js


# ---- nodejs-mobile prebuilt runtime (~120 MB) ----
# fetched by client-source-code/client-development/mobile/nodejs-client/fetch-nodejs-mobile.py, not committed
client-source-code/client-development/mobile/android/app/src/main/jniLibs/
client-source-code/client-development/mobile/android/app/src/main/cpp/nodejs-mobile-include/

# ---- generated at build time by the gradle copyNodeProject task ----
client-source-code/client-development/mobile/android/app/src/main/assets/nodejs-project/

# written by the java bridge on device / the desktop bridge test
client-source-code/client-development/mobile/nodejs-client/bridge.json

# node's on-device debug log (also written by desktop test runs)
client-source-code/client-development/mobile/nodejs-client/node-log.txt*

# gradle native build output (regenerated from src/main/cpp/CMakeLists.txt on every build)
client-source-code/client-development/mobile/android/app/.cxx/

# selfhosting-tools/wireguard/ setup: saved answers, key pairs and the tunnel config of this machine
selfhosting-tools/wireguard/answers.json
selfhosting-tools/wireguard/keys/
selfhosting-tools/wireguard/ssh/
selfhosting-tools/wireguard/lemon-wg0.conf

# written by tests/server/audio-websocket-test.js on every run
.audio-test-runtime/

# Local tests are kept on this computer, not in Git.
/tests/

# Reuse the extracted OpenSSL sources locally; do not commit the build cache.
/server-source-code/third-party/stunnel/win-build/
/server-source-code/build/

# ---- Native desktop client ----
