
#!/bin/bash

# Check if the symlink libdatachannel.so.0.24 exists and points to the correct target
TARGET="libdatachannel.so"
LINK="libdatachannel.so.0.24"

# Ensure the target file exists
if [ ! -e "$TARGET" ]; then
    echo "Target file $TARGET does not exist. Exiting."
    exit 1
fi

if [ -L "$LINK" ]; then
    CURRENT_TARGET=$(readlink "$LINK")

    if [ "$CURRENT_TARGET" = "$TARGET" ]; then
        echo "Symlink $LINK already exists and points to $TARGET."
    else
        echo "Symlink $LINK exists but points to $CURRENT_TARGET. Updating..."
        rm "$LINK"
        ln -s "$TARGET" "$LINK"
        echo "Symlink $LINK -> $TARGET created."
    fi
elif [ -e "$LINK" ]; then
    echo "File $LINK exists but is not a symlink. Deleting it and creating new"
    rm "$LINK"
    ln -s "$TARGET" "$LINK"
    echo "Symlink $LINK -> $TARGET created."
else
    # If the symlink doesn't exist, create it
    ln -s "$TARGET" "$LINK"
    echo "Symlink $LINK -> $TARGET created."
fi

#make binary runnable
chmod +x chat-server.bin 

#increase max allowed number of file descriptors to higher value
#1024 by default on some systems, makes system unable to accept new websocket connections
ulimit -n 65535 

#LD_LIBRARY_PATH is environment variable, equivalent to %PATH% in windows
#unlike windows, linux doesnt look for dynamic libraries in current working directory, so you have to tell him where to look for .so files (.dll equivalent)

export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$PWD"
./chat-server.bin

