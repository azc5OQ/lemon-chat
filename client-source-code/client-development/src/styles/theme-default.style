.add-tag-context-menu-items::-webkit-scrollbar-track, .chat-input-container-context-menu-items::-webkit-scrollbar-track, #space-devider1:-webkit-scrollbar-track, #channel-list-container::-webkit-scrollbar-track, #chat-context-container::-webkit-scrollbar-track, #chat-input-container-text-input::-webkit-scrollbar-track, body::-webkit-scrollbar-track {
