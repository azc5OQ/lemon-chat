/* this theme's --set-* dialog palette, because layout.style lays out and paints every dialog from these variables */
:root {

    --set-font: 'Raleway', sans-serif;
    --set-panel: #36393f;
    --set-text: #e6e8ea;
    --set-muted: rgba(255, 255, 255, 0.45);
    --set-line: rgba(255, 255, 255, 0.10);
    --set-line-soft: rgba(255, 255, 255, 0.05);
    --set-accent: #05a3ff;
    --set-accent-soft: rgba(5, 163, 255, 0.25);
    --set-accent-text: #ffffff;
    --set-field: rgba(255, 255, 255, 0.06);
    --set-field-text: #e6e8ea;
    --set-row-hover: rgba(255, 255, 255, 0.05);
    --set-selected: rgba(5, 163, 255, 0.16);
    --set-chip: rgba(120, 140, 180, 0.22);
    --set-radius: 5px;
    --set-danger: #e06060;
    --set-danger-soft: rgba(224, 96, 96, 0.16);
    --set-danger-strong: #ff7b7b;

    --set-button-bg: #0e69a8;
}

#server-settings-tab {
    position: absolute;
    z-index: 2;
    display: none;
    width: 50%;
    min-width: 750px;
    min-height: 400px;
    height: 50%;
    background-color: #36393f;

    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    box-shadow: 0 12px 38px rgba(0, 0, 0, 0.5);
}

#server-settings-tab-subcontainer {
    display: inline-block;
    width: 172px;
    background-color: #414f53;
    height: 100%;
    vertical-align: top;
    color: white;

    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    cursor: move;
}

#server-settings-tab-subcontainer2 {
    display: inline-block;
    width: calc(100% - 187px);
    height: 100%;
    font-family: 'Raleway', sans-serif;
}

#custom-file-upload-button-image {
    background-image: url(data:image/png;base64,);
}

.custom-file-upload-button {
    display: inline-block;
    background-color: #05a3ff;
    font-family: sans-serif;
    color: #ffffff;
    padding: 15px 1px 15px 15px;
    text-align: center;
    width: 15px;
    cursor: pointer;
    border-radius: 7px;
    transition: 0.3s ease;
    vertical-align: top;
    background-repeat: no-repeat;
    background-size: contain;
}

.button-1 {
    width: 58px;
    height: 29px;
