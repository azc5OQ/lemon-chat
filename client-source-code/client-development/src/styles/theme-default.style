* {
    margin: 0px;
    padding: 0px;
    position: relative;
}

/* slim scrollbars for firefox, because it ignores the ::-webkit-scrollbar rules below */
@supports (-moz-appearance: none) {
    * {
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
    }
}

html {
    background-image: linear-gradient( 109.6deg, rgba(15,2,2,1) 11.2%, rgba(36,163,190,1) 91.1%);
    height: 100%;
    width: 100%;
    margin: 0px;
}

body {
    min-height: 100%;
    margin: 0px;
    overflow: hidden;
}

#verification-system {
    min-height: 100vh;
    text-align: center;
}

div {
    position: relative;
}

#body-container {
    height: 100vh;
    min-width: 550px;
}

.marquee-music-playing-container {
    display: none;
    vertical-align: middle;
    white-space: nowrap;
    bottom: 1px;
}

#idle-clients-container {
    height: 30%;
    overflow-x: hidden;
    overflow-y: scroll;
    display: none;
}

a-toast {
    position: fixed;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 100;
    top: 40%;
    background-color: #FFF;
    min-width: 200px;
    text-align: center;
    border: solid;
    border-width: 1px;
    border-color: #7781b1;
    vertical-align: top;
    padding: 10px;
    font-family: roboto,sans-serif;
    min-height: 20px;
    cursor: pointer;
}

a-toast:hover {
    background-color: grey;
}

#microphone-always-broadcasting-audio-button {
    display: block;
    position: absolute;
    z-index: 1;
    top: 0;
    right: 116px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-repeat: no-repeat;
    background-position: center center;
    background-color: black;
    background-size: 16px 16px;
    background-image: url(data:image/png;base64,);
}

.marquee-music-playing-container > p {
    display: inline-block;
    font-size: 13px;
    vertical-align: top;
    color: #7dffbd;
}

.client-mute-state {
    display: none;
    width: 20px;
    float: right;
    height: 20px;
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 20px 20px;
    left: 3px;
    top: 1px;
    background-image: url(data:image/png;base64,);
}

.client-ignore-state {
    display: none;
    position: absolute;
    inset: 0;
    stroke: #fffa00;
    stroke-width: 4px;
    pointer-events: none;
    z-index: 2;
    height: 10px;
    top: 8px;
    left: 26px;
}

#android-settings-button {
    display: none;
}

.marquee {
    width: 100px;
    white-space: nowrap;
    overflow: hidden;
    display: inline-block;
    height: 15px;
    vertical-align: top;
}

#hide-show-flags-button {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 143px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-repeat: no-repeat;
    background-position: center center;
    background-color: #000000;
    background-size: 16px 16px;
    background-image: url(data:image/png;base64,);
}

#sound-effects-button {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 169px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-repeat: no-repeat;
    background-position: center center;
    background-color: #000000;
    background-size: 19px 19px;
    background-image: url(data:image/svg+xml;base64,);
}

.marquee div {
    padding-left: 100%;
    display: inline-block;
    font-family: roboto,sans-serif;
    font-size: 11px;
    vertical-align: top;
    color: #7ee8ff;
    padding-top: 2px;
    animation-duration: 40s;
    animation-timing-function: linear;
    animation-delay: 0s;
    animation-iteration-count: infinite;
    animation-direction: normal;
    animation-fill-mode: none;
    animation-play-state: running;
    animation-name: animate;
}

.chat-controls-container {
    display: inline-block;
    vertical-align: top;
    float: right;
    white-space: nowrap;
}

.p-marquee-song-icon {
    padding-left: 19px;
    background-image: url(data:image/png;base64,);
    background-repeat: no-repeat;
    background-size: 13px 15px;
}

#custom-file-upload-button-icon {
    display: inline-block;
    padding: 4px 5px 0px 5px;
    text-align: center;
    width: 97px;
    height: 20px;
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    transition: 0.3s ease;
    border-radius: 3px;
    color: white;
    vertical-align: baseline;
    cursor: pointer;
    background: #7d8799;
}

#custom-file-upload-button-icon:hover {
    background-color: #36393f;
}

.tag-head-p-container {
    white-space: nowrap;
}

.tag-settings-entry-p {
    display: inline-block;
    vertical-align: top;
    padding-top: 6px;
    padding-right: 20px;
    padding-left: 20px;
    color: azure;
    width: 100px;
}

.tag-settings-entry-img {
    display: inline-block;
    vertical-align: top;
    padding-top: 6px;
    margin-left: 19px;
    color: azure;
    width: 25px;
    height: 25px;
    background-repeat: no-repeat;
    background-size: 30px 30px;
}

@keyframes animate {
    100% {
        transform: translate(-100%, 0);
    }
}

#space-devider1 {
    border-right: 1px dotted #161717;
}

#space-devider-41 {
    width: 25px;
    height: 20px;
    display: inline-block;
}

#space-devider-42 {
    display: inline-block;
    width: 13%;
    height: 100%;
    white-space: normal;
    border-left: 1px dotted #0c4e5d;
}

#drag-resize-chat {
    display: inline-block;
    height: 95%;
    vertical-align: top;
    border-left: 2px dashed transparent;
    cursor: ew-resize;
    width: 2px;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -khtml-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
}

#add-key-button {
    visibility: hidden;
}

.imgnotsentyet {
    opacity: 0.3 !important;
}

#drag-resize-chat:hover {
    border-left: 2px solid #696555;
    cursor: resize;
}

#chat-context-container {
    display: inline-block;
    vertical-align: top;
    width: 100%;
    overflow: auto;
    height: 100%;
}

#spacer-between-chat-and-users {
    display: inline-block;
    vertical-align: top;
    width: 100%;
    overflow-y: scroll;
    height: 100%;
}

.collapsed {
    display: none !important;
}

#space-devider1 {
    width: 15%;
    display: inline-block;
    vertical-align: top;
    height: 100%;
    overflow-x: scroll;
    overflow-y: hidden;
    min-width: 100px;
}

#space-devider2 {
    display: inline-block;
    vertical-align: top;
    height: 100%;
    width: 73%;
    left: -4px;
}

.chat-picture-img {
    max-width: 600px;
    background: inherit !important;
}

.chat-picture-img-default {
    width: 32px !important;
    height: 32px !important;
}

.local-client-chat-picture-img:hover {
    opacity: 0.8;
}

#current-client-avatar {
    width: 72px;
    height: 72px;
    display: block;
    margin: 6px auto;
    border-radius: 50%;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center center;
}

.text-input-container {
    padding-top: 10px;
    padding-bottom: 10px;
}

.text-input-container-2 {
    padding-top: 4px;
    padding-bottom: 4px;
}

#stop-song {
    display: none;
    background-image: url(data:image/png;base64,);
    background-repeat: no-repeat;
    background-size: 24px 24px;
    height: 30px;
    width: 30px;
    background-position-x: center;
    background-position-y: center;
    background-color: #05a3ff;
    transition: 0.3s ease;
    cursor: pointer;
}

#stop-song:hover {
    background-color: #7d8799;
}

.server-settings-tab-li {
    cursor: pointer;
}

#server-settings-tab-icons {
    height: 100%;
    display: block;
}

.client-description-tag-entry-icon {
    width: 18px;
    height: 18px;
    vertical-align: top;
    display: inline-block;
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 18px 18px;
}

.single-channel-is-audio-disabled {
    height: 16px;
    margin-top: 3px;
    width: 16px;
    float: right;
    background-image: url(data:image/png;base64,);
    background-repeat: no-repeat;
}

.single-channel-is-using-password {
    display: inline-block;
    background-image: url(data:image/png;base64,);
    background-repeat: no-repeat;
    background-size: 20px 18px;
    padding-left: 24px !important;
}

.single-channel-is-temp {
    font-style: italic;
    color: #6fd0c0;
}

.single-channel-is-temp::after {
    content: " (temp)";
    font-size: 11px;
    opacity: 0.7;
}

.client-description-tag-entry-name {
    width: calc(100% - 30px);
    display: inline-block;
    vertical-align: top;
    font-style: normal;
    color: black;
    font-size: 14px;
}

#server-settings-tab-upload-icon-file-input-container, #server-settings-tab-add-tag-details-container {
    height: 46px;
    background-color: #414f53;
    text-align: left;
}

#server-settings-general-settings-container {
    height: 100%;
    box-sizing: border-box;
    color: white;
    text-align: left;
    font-family: 'Raleway', sans-serif;
    overflow-y: auto;
}

.server-settings-general-header {
    margin: 0 0 14px 0;
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: white;
}

.server-settings-general-row {
    display: flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    margin-bottom: 12px;
    font-family: 'Raleway', sans-serif;
    font-size: 14px;
    color: white;
    cursor: pointer;
}

.server-settings-general-row input[type="checkbox"] {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: #05a3ff;
    cursor: pointer;
}

#server-settings-bans-header {
    margin-top: 22px;
}

#server-settings-bans-list {
    margin-top: 4px;
}

.ban-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid #4f5d61;
}

.ban-entry-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-family: 'Raleway', sans-serif;
}

.ban-entry-ip {
    color: white;
    font-weight: 600;
    font-size: 13px;
}

.ban-entry-meta {
    color: #9fb0b5;
    font-size: 11px;
}

.ban-entry-identity {
    color: #7f9197;
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 240px;
}

.ban-entry-remove {
    flex-shrink: 0;
    padding: 4px 10px;
    background-color: #8a2f2f;
    color: white;
    border-radius: 5px;
    font-size: 12px;
    cursor: pointer;
    user-select: none;
}

.ban-entry-remove:hover {
    background-color: #a83838;
}

.ban-entry-empty {
    color: #9fb0b5;
    font-size: 13px;
    font-family: 'Raleway', sans-serif;
}

#save-server-settings-button {
    display: inline-block;
    margin-top: 10px;
    padding: 7px 14px;
    border: 0px;
    border-radius: 3px;
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    color: white;
    cursor: pointer;
    transition: 0.3s ease;
    background: #7d8799;
}

#save-server-settings-button:hover {
    background-color: #36393f;
}

#server-settings-tab-tags {
    display: none;
    height: 100%;
}

#server-settings-tab-general-settings {
    display: none;
    height: 100%;
}

#server-settings-tab-bans {
    display: none;
    height: 100%;
}

#server-settings-bans-container {
    height: 100%;
    box-sizing: border-box;
    color: white;
    text-align: left;
    font-family: 'Raleway', sans-serif;
    overflow-y: auto;
}

#add-new-tag-to-server-button {
    display: inline-block;
    padding: 2px 5px 9px 5px;
    text-align: center;
    width: 97px;
    border: 0px;
    height: 20px;
    font-family: 'Raleway', sans-serif;
    font-size: 13px;
    transition: 0.3s ease;
    border-radius: 3px;
    color: white;
    vertical-align: baseline;
    cursor: pointer;
    background: #7d8799;
}

#add-new-tag-to-server-button:hover {
    background-color: #36393f;
}

#communication-system-container {
    height: 80%;
    display: none;
    min-width: 329px;
    white-space: nowrap;
}

.client-audio-state {
    display: inline-block;
    width: 20px;
    height: 20px;
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 17px 17px;
}

.client-audio-state-microphone-disabled {
    background-image: url("data:image/png;base64,");
}

.client-audio-state-microphone-active {
    background-image: url("data:image/png;base64,");
}

.client-audio-state-microphone-enabled {
    background-image: url("data:image/png;base64,");
}

.client-audio-state-completely-disabled {
    background-image: url(data:image/png;base64,);
    background-size: 16px 16px;
}

.client-tags {

    float: right;
}

.connected-client-p {
    display: inline-block;
    color: #63eb2c;
    vertical-align: top;
    margin-top: 2px;
    font-family: sans-serif;
}

.connected-client-p-music-bot {
    color: #8abbbb !important;
}

.connected-client-p-received-messages-number {
    display: none;
    float: right;
    font-size: 0.8em;
    color: gold;
    padding-top: 0.2em;
    background-color: #6b7c99;
    padding-left: 0.5em;
    padding-right: 0.5em;
    padding-bottom: 0.2em;
    border-radius: 14px;
    bottom: 0.1em;
}

#communication-system-head-menu {
    min-height: 30px;
    background-color: black;
    color: white;
    text-align: right;
}

.single-server-message {
    padding-left: 20px;
    padding-top: 5px;
    background-color: inherit;
    border-radius: 9px;
    color: #898e8c;
    font-family: sans-serif;
    font-size: 10px;
    margin: 0px;
    font-weight: bold;
    font-style: italic;
    word-wrap: break-word;
    width: 80%;
}

#admin-password-input-container {
    text-align: center;
}

#channel-password-input-container {
    height: 120px;
    text-align: center;
}

#channel-properties-input-container {
    height: auto !important;
    text-align: center;

    box-sizing: border-box;
    padding: 14px 18px 18px 18px;
}

#connect-form-sub-container-1, #connect-form-sub-container-2 {
    display: inline-block;
    visibility: hidden;
}

#image-upload-preview {
    height: 70px;
    width: 85px;
    border-radius: 11px;
    display: none;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
}

#chat-input-file-input-container {
    width: calc(100% - 210px); /* 210px is reserved because the controls row incl. the paperclip must fit beside the text box */
    display: inline-block;
    vertical-align: top;
    padding: 0.5em;
    background-color: #202020;
    border-radius: 6px;
}

#chat-input-container-text-input {
    width: 100%;
    min-height: 77px;
    background-color: #202020;
    color: white;
    border-radius: 5px;
    display: inline-block;
    vertical-align: top;
    outline: none;
    border: none;
    font-family: sans-serif;
    resize: none;
}

.single-tag {
    width: 20px;
    height: 20px;
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 20px 20px;
    display: inline-block;
    padding-left: 2px;
    padding-right: 2px;
}

.padding-div {
    display: inline-block;
    vertical-align: top;
    height: 10px;
}

#chat-input-container-text-input[disabled] {
    background-color: #36393f;
}

#channel-list-container {
    background-color: inherit;
    color: white;
    height: calc(100% - 30px);
    font-family: sans-serif;
    display: inline-block;
    vertical-align: top;
    width: 100%;
    overflow-y: scroll;
    overflow-x: hidden;
    margin-bottom: 30px;
}

#contextmenus-container {
    position: absolute;
    z-index: 1;
    top: 0px;
    width: 0px;
    height: 0px;
}

.channel-list-context-menu, .chat-input-container-context-menu {
    position: absolute;
}

.add-tag-context-menu {
    display: none;
    position: absolute;
    max-height: 285px;
    overflow-y: hidden;
}

.channel-list-context-menu-background, .chat-input-container-context-menu-background {
    background-color: #60656f;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    height: auto;
    border-radius: 10px;
    opacity: 0.8;
    background: linear-gradient(180deg,#003d75 0,#232b56 100%);
}

.add-tag-context-menu-background {
    background: linear-gradient(180deg,#003d75 0,#232b56 100%);
    width: 130px;
    height: 100%;
    border-radius: 10px;
    opacity: 0.8;
    position: absolute;
}

.channel-list-context-menu-items {
    position: relative;
    top: 0px;
    width: 130px;
    overflow: hidden;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

.chat-input-container-context-menu-items {
    position: relative;
    top: 0px;
    width: 130px;
    height: 154px;
    overflow-y: scroll;
    overflow-x: hidden;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

.context-menu-item-disabled {
    opacity: 0.7 !important;
    cursor: default !important;
}

.channel-list-context-menu-items p, .channel-list-context-menu-items label, .chat-input-container-context-menu-items p, .chat-input-container-context-menu-items label {
    color: white;
    top: 0px;
    width: 130px;
    font-size: 1em;
    font-family: sans-serif;
    padding: 5px;
    cursor: pointer;
    display: block;
}

.channel-list-context-menu-items p:hover, .channel-list-context-menu-items label:hover, .chat-input-container-context-menu-items p:hover, .chat-input-container-context-menu-items p:hover {
    background-color: #b9d436;
}

#current-client-description-client-name {
    padding: 7px;
    font-family: sans-serif;
    color: #63eb2c;
    font-size: 15px;
    font-style: normal;
}

#channel-properties-disable-audio-checkbox {
    height: 25px;
}

.add-tag-context-menu-items {
    width: 136px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    overflow-y: scroll;
    height: 280px;
    overflow-x: hidden;
    border-radius: 10px;
}

.add-tag-context-menu-items p {
    color: white;
    display: block;
    background-repeat: no-repeat;
    background-size: 22px 22px;
    background-position: right center;
    background-position-x: 102px;
    font-size: 15px;
    font-family: sans-serif;
    padding-top: 5px;
    padding-bottom: 5px;
    cursor: pointer;
    white-space: nowrap;
}

.add-tag-context-menu-items p:hover {
    background-color: #b9d436;
}

.add-tag-context-menu-item {
    color: white;
    top: 0px;
    width: 130px;
    font-size: 1em;
    font-family: sans-serif;
    padding: 5px;
    cursor: pointer;
}

.add-tag-context-menu-item:hover {
    background-color: #b9d436;
}

.chat-message-context-menu-background {
    background-color: #60656f;
    width: 130px;
    height: 48px;
    opacity: 0.8;
}

.img-uploaded-icon {
    width: 32px;
    height: 32px;
    margin: 10px;
    vertical-align: top;
    display: inline-block;
    cursor: pointer;
    transition: 0.3s ease;
    border-radius: 5px;
}

.img-uploaded-icon:hover {
    background-color: #ffffff;
}

.chat-message-context-menu-items {
    position: absolute;
    top: 0px;
    width: 130px;
    overflow: hidden;
    background: linear-gradient(109.6deg, #8361af 11.2%, rgb(36 163 190 / 69%) 91.1%);
}

.chat-message-context-menu-items p {
    color: white;
    top: 0px;
    width: 130px;
    font-size: 0.7em;
    font-family: sans-serif;
    padding: 5px;
    cursor: pointer;
    overflow: hidden;
}

.chat-message-context-menu-items p:hover {
    background-color: #b9d436;
}

.connected-client {
    padding-left: 19px;
}

.single-channel {
    cursor: pointer;
    padding-left: 15px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-family: sans-serif;
    color: white;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -khtml-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    min-width: 141px;
    white-space: nowrap;
}

.single-channel-collapse-button {
    width: 24px;
    height: 24px;
    display: inline-block;
    vertical-align: top;
    background-repeat: no-repeat;
    background-size: 24px 24px;
    background-image: url(data:image/png;base64,);
}

.single-channel-collapse-button:hover {
    cursor: pointer;
    background-image: url(data:image/png;base64,);
}

.single-channel-expand-button {
