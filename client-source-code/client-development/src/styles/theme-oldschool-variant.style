}

.channel-list-context-menu-items, .chat-input-container-context-menu-items, .add-tag-context-menu-items, .chat-message-context-menu-items {
    border-radius: 0 !important;
}

.channel-list-context-menu-items p, .channel-list-context-menu-items label, .chat-input-container-context-menu-items p, .add-tag-context-menu-items p, .chat-message-context-menu-items p {
    border-radius: 0 !important;
    padding: 3px 20px 3px 9px !important;
    color: #000000;
}

.channel-list-context-menu-items p:hover, .channel-list-context-menu-items label:hover, .chat-input-container-context-menu-items p:hover, .add-tag-context-menu-items p:hover, .chat-message-context-menu-items p:hover {
