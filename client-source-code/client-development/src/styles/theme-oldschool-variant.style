}

#space-devider4 {
    padding: 6px 8px;
    display: inline-block;
    vertical-align: top;
    height: 20%;
    width: 73%;
}

::-webkit-scrollbar-corner {
    background-color: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(61, 122, 200, 0.4);
    border: none;
    background-color: #b0bece;
    border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
    background: #a0aab8;
    background-color: #8aaac8;
}

::-webkit-scrollbar {
    width: 6px;
