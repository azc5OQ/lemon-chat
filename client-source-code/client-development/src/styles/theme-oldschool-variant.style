}

.channel-list-context-menu-background, .add-tag-context-menu-background {
    background-color: #f0f0f0 !important;
    border: 0px !important;
    box-shadow: none !important;
}

.country-flag- {
    width: 0px !important;
}

.single-channel-icon {
    float: right;
}
/* the admin-password and identity dialogs carry a disabled "label" input that just repeats the
   dialog title (both dialogs share the #admin-password-input-container id); this theme has real
   title bars, so hide the duplicate label here rather than removing it from the markup */
#admin-password-input-container .text-input-not-pretty[disabled] {
    display: none;
}


#space-devider1 {
    border-right: 1px solid #828790;
}
/* hover for the new toolbar icons, matching the oldschool icon-button hover */
#choose-theme-button:hover,
#layout-edit-button:hover,
#switch-identity-button:hover {
    background-color: #c0ccd8 !important;
}

/* state-dependent toolbar icons for oldschool. the class is set by sync_toolbar_state_classes()
   in main.js; !important beats the inline background-image the default theme sets, so this only
   changes oldschool while the other themes keep their JS-driven icons. */
#sound-effects-button.sfx-on { background-image: url(data:image/svg+xml;base64,) !important; }
#sound-effects-button:not(.sfx-on) { background-image: url(data:image/svg+xml;base64,) !important; }
#microphone-always-broadcasting-audio-button.mic-on { background-image: url(data:image/svg+xml;base64,) !important; }
#microphone-always-broadcasting-audio-button:not(.mic-on) { background-image: url(data:image/svg+xml;base64,) !important; }
#hide-chat-button.chat-hidden { background-image: url(data:image/svg+xml;base64,) !important; }
#hide-chat-button:not(.chat-hidden) { background-image: url(data:image/svg+xml;base64,) !important; }

/* ---- old school variant only: TeamSpeak-style framed panels ----
   every grid panel (channels column, chat log, info pane, chat input) gets the SAME 1px sunken
   frame, so the boxes are even - not just the inner content areas. the old-school single-side
   column dividers are cleared so nothing doubles up. variant-only; tweak colour/shadow to taste. */
#space-devider1 { border-right: 0 !important; }
#chat-window-container { border-left: 0 !important; }
#space-devider-42 { border-left: 0 !important; }

#space-devider1,
#space-devider2,
#space-devider-42,
#space-devider4 {
    border: 1px solid #8b929c !important;
    box-shadow: inset 1px 1px 3px rgba(0, 0, 0, 0.12);
    box-sizing: border-box !important;
}

/* empty gutters between the panels: the layout js sets the grid tracks but never a gap, so adding
   one here (variant-only) floats each panel as its own box over the window backdrop (the html
   #f0f0f0 shows through the gaps + padding) - the TeamSpeak look. other themes carry no gap rule,
   so they stay flush and are unaffected. */
#communication-system-container {
    gap: 5px;
    padding: 5px;
    box-sizing: border-box;
}


.single-chat-message-content-p {
    color: #000000;
    font-size: 9px !important;
    font-family: Tahoma !important;
}