}

#channel-properties-input-container .text-input-not-pretty-2, #channel-password-enter .text-input-not-pretty-2, #admin-password-enter .text-input-not-pretty-2, #poke-client-enter .text-input-not-pretty-2, #set-new-username-enter .text-input-not-pretty-2 {
