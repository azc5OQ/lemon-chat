    background-color: #3d7ac8;
}

html {
    height: 100%;
    width: 100%;
    margin: 0px;
    background: #f0f0f0;
}

body {
    min-height: 100%;
    margin: 0px;
    overflow: hidden;
    color: #000000;
}

body, input, button, textarea, select, p, li, label {
    font-family: Tahoma, "Segoe UI", Arial, sans-serif;
    font-size: 11px;
}

#space-devider1 {
    width: 15%;
    display: inline-block;
    vertical-align: top;
    height: 100%;
    overflow-x: hidden;
    overflow-y: hidden;
    min-width: 100px;
    background: #ffffff;
    border-right: 2px solid #828790;
}

#channel-list-container {
    background-color: inherit;
    color: #1a1a1a;
    height: calc(100% - 30px);
    font-family: Tahoma, Arial, sans-serif;
    display: inline-block;
    vertical-align: top;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    margin-bottom: 30px;
    background: #ffffff;
}

#idle-clients-container {
    height: 30%;
    overflow-x: hidden;
    overflow-y: auto;
    display: none;
    border-top: 1px solid #b6b6b6;
}

.single-channel:hover {
    background-color: #cce4ff;
    color: #000000;
}

.connected-client-p {
    display: inline-block;
    vertical-align: top;
    font-family: Tahoma, Arial, sans-serif;
    color: #000000;
    font-size: 11px;
    margin-top: 0;
}

#space-devider2 {
    display: inline-block;
    vertical-align: top;
    height: 100%;
    width: 73%;
    left: -4px;
    background: #ffffff;
    overflow: hidden;
}

#chat-context-container {
    display: inline-block;
    vertical-align: top;
    width: 99%;
    overflow-y: auto;
    overflow-x: hidden;
    height: calc(100% - 33px);
    background: #ffffff;
}

#chat-context-selectors-container {
    padding: 5px 6px 0 6px;
    min-height: 28px;
    padding-left: 25px;
    border-bottom: 1px solid #828790;
}

.single-chat-message-content {
    padding-top: 3px;
    max-width: 943px;
    word-break: break-all;
    color: #000000;
    font-size: 11px;
}

.single-chat-message-sender-username-container, .single-chat-message-sender-local-username-container {
    color: #00309c;
    font-size: 11px;
    font-weight: bold;
}

.single-chat-message-sender-time {
    display: inline-block;
    vertical-align: middle;
    font-style: italic;
    font-family: Tahoma, Arial, sans-serif;
    font-weight: bold;
    color: #808080;
    font-size: 10px;
}

#communication-system-head-menu {
    min-height: 30px;
    background-color: #f0f0f0;
    text-align: right;
    background: #ece9d8;
    border-bottom: 1px solid #828790;
    color: #000000;
}

.button-1, #chat-input-container-send-chat-input, #save-server-settings-button {
    background: linear-gradient(180deg, #fdfdfd 0%, #e2e2e2 100%);
    color: #000000;
    border: 1px solid #8e8e8e;
    border-radius: 3px;
    box-shadow: none;
    font-weight: normal;
    font-size: 11px;
}

#server-settings-tab {
    color: #1a1a1a;
    position: absolute;
    z-index: 2;
    display: none;
    width: 50%;
    min-width: 750px;
    min-height: 400px;
    height: 50%;
    background-color: #f0f0f0;
    opacity: 0.92;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    background: #ece9d8;
}

#server-settings-tab-subcontainer {
    display: inline-block;
    width: 172px;
    height: 100%;
    vertical-align: top;
    font-family: 'Kavoon';
    cursor: move;
    background-color: #e0e8f0;
    background: #ece9d8;
    color: #000000;
}

#server-settings-tab-subcontainer2 {
    display: inline-block;
    width: calc(100% - 187px);
    height: 100%;
    font-family: 'Raleway';
    background: #ffffff;
}

#server-settings-general-settings-container, #server-settings-bans-container {
    background: #ffffff;
    color: #000000;
}

.single-channel-name-p {
    display: inline-block;
    font-size: 11px;
    font-weight: normal;
    letter-spacing: 0;
    color: #000000;
    background-image: url("data:image/svg+xml;base64,");
    background-repeat: no-repeat;
    background-position: 0px center;
    background-size: 14px 14px;
    padding-left: 19px;
}

.single-channel-name-p.single-channel-is-using-password {
    background-image: url("data:image/svg+xml;base64,");
    background-size: 14px 14px;
    padding-left: 19px !important;
}

.single-channel-name-p.single-channel-is-full {
    background-image: url("data:image/svg+xml;base64,");
    background-size: 14px 14px;
    padding-left: 19px !important;
}

.client-audio-state-microphone-active {
    background-image: url("data:image/svg+xml;base64,");
}

.client-audio-state-microphone-enabled {
    background-image: url("data:image/svg+xml;base64,");
}

.client-audio-state-microphone-disabled {
    background-image: url("data:image/svg+xml;base64,");
}

.single-channel-collapse-button, .single-channel-expand-button, .single-channel-collapse-button:hover, .single-channel-expand-button:hover {
    width: 16px !important;
    height: 16px !important;
    background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMDAlIiBoZWlnaHQ9IjEwMCUiIHZpZXdCb3g9IjAgMCAxNiAxNiI+PHBhdGggZD0iTTQgNiBMOCAxMC41IEwxMiA2IiBmaWxsPSJub25lIiBzdHJva2U9IiM1NTU1NTUiIHN0cm9rZS13aWR0aD0iMi40IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=") !important;
    background-repeat: no-repeat !important;
    background-position: center !important;
    background-size: 13px 13px !important;
    background-color: transparent !important;
    border-radius: 0 !important;
    vertical-align: middle !important;
    cursor: default !important;
}

.single-channel-expand-button, .single-channel-expand-button:hover {
    background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMDAlIiBoZWlnaHQ9IjEwMCUiIHZpZXdCb3g9IjAgMCAxNiAxNiI+PHBhdGggZD0iTTYgNCBMMTAuNSA4IEw2IDEyIiBmaWxsPSJub25lIiBzdHJva2U9IiM1NTU1NTUiIHN0cm9rZS13aWR0aD0iMi40IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=") !important;
}

.single-channel-name-p, .single-channel .single-channel-name-p {
    font: normal 11px/16px Tahoma, "Segoe UI", Arial, sans-serif !important;
    letter-spacing: 0 !important;
    color: #000000 !important;
    vertical-align: middle !important;
    white-space: nowrap !important;
    background-repeat: no-repeat !important;
    background-position: 0px center !important;
    background-size: 16px 16px !important;
    padding-left: 20px !important;
}

.single-channel-name-p.single-channel-is-using-password, .single-channel-name-p.single-channel-is-full {
    background-size: 16px 16px !important;
    background-position: 0px center !important;
    padding-left: 20px !important;
}

.connected-client, .connected-local-client {
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -khtml-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    min-width: max-content;
    cursor: default;
    padding-top: 0 !important;
    padding-bottom: 1px !important;
    line-height: 16px !important;
    min-height: 0 !important;
    white-space: nowrap;
}

.connected-client-p, #idle-clients-container .connected-client-p {
    font: normal 11px/16px Tahoma, "Segoe UI", Arial, sans-serif !important;
    color: #000000 !important;
    margin-top: 0 !important;
    vertical-align: middle !important;
    white-space: nowrap !important;
}

.client-audio-state {
    display: inline-block;
    background-repeat: no-repeat;
    width: 16px !important;
    height: 16px !important;
    background-size: 16px 16px !important;
    background-position: center center !important;
    vertical-align: middle !important;
}

.client-audio-state-completely-disabled {
    background-image: url("data:image/svg+xml;base64,");
    background-size: 16px 16px !important;
}

.single-chat-message-content, .single-chat-message-sender-username-container, .single-chat-message-sender-local-username-container {
    font-family: Tahoma, "Segoe UI", Arial, sans-serif !important;
    font-size: 11px !important;
}

#chat-input-container-text-input {
    line-height: 1.5;
    padding: 4px 8px;
    caret-color: #3d7ac8;
    width: 97% !important;
    min-height: 77px;
    border-radius: 5px;
    display: inline-block;
    vertical-align: top;
    outline: none;
    resize: none;
    background-color: transparent;
    color: #000000;
    border: 0px solid #828790;
    font-family: Tahoma, "Segoe UI", Arial, sans-serif !important;
    font-size: 11px !important;
}

.single-channel-name-p, .connected-client-p, #idle-clients-container .connected-client-p {
    margin: 0 !important;
}

.single-channel, .single-channel-name-p, .single-channel-collapse-button, .single-channel-expand-button, .connected-client, .connected-local-client, .connected-client-p {
    cursor: default !important;
}

.connected-client, .connected-local-client, .single-channel {
    --row-rightclick-selection: #b3d4ef;
}

.connected-client:hover, .connected-local-client:hover, .single-channel:hover {
    background-color: #dceafb !important;
}

.single-channel-no-children .single-channel-collapse-button, .single-channel-no-children .single-channel-expand-button {
    visibility: hidden !important;
}

.connected-client:not(.idle-client), .connected-local-client:not(.idle-client) {
    padding-left: 23px !important;
}

.single-channel {
    cursor: default;
    padding-left: 15px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-family: Tahoma, Arial, sans-serif;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -khtml-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    min-width: 141px;
    font-size: 11px;
    color: #000000;
    border-radius: 0;
    padding: 0 2px 0 4px !important;
    margin: 0 !important;
    min-height: 0 !important;
    line-height: 16px !important;
    white-space: nowrap;
    position: relative;
}

.single-channel:has(.single-channel-is-using-password)::after {
    content: "";
    position: absolute;
    right: 8px;
    top: 2px;
    width: 13px;
    height: 13px;
    background-image: url("data:image/svg+xml;base64,");
    background-size: contain;
    background-repeat: no-repeat;
}

#channel-properties-input-container .text-input-container-2 {
    height: 24px !important;
    line-height: 36px !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
}

#channel-properties-input-container .text-input-container-2 > input {
    vertical-align: middle !important;
}

#connected-local-client-input {
    background-color: inherit;
    font-family: Tahoma, Arial, sans-serif;
    font-weight: bold;
    display: inline-block;
    outline: none;
    border: 0px;
    width: 80px;
    height: 16px;
    color: #000000 !important;
