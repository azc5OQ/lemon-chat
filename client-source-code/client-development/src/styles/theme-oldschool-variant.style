}

#channel-properties-input-container .text-input-not-pretty-2[disabled], #channel-password-enter .text-input-not-pretty-2[disabled], #admin-password-enter .text-input-not-pretty-2[disabled], #poke-client-enter .text-input-not-pretty-2[disabled], #set-new-username-enter .text-input-not-pretty-2[disabled] {
    border: none !important;
    background: transparent !important;
    color: #000000 !important;
    -webkit-text-fill-color: #000000 !important;
    opacity: 1 !important;
}

.close-button {
    width: 25px !important;
    height: 21px !important;
    padding: 3px 3px 0 0 !important;
    float: right;
    position: relative;
    border: none !important;
    box-shadow: none !important;
}

.close-button:hover {
    background-color: #c50f1f !important;
    border: none !important;
}

.close-button::before {
    content: "\2715";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    text-align: center;
    line-height: 23px;
    font-size: 12x;
    color: #404040 !important;
}

.close-button:hover::before {
    color: #000000 !important;
}

#channel-properties-edit, #channel-properties-edit *, #channel-password-enter, #channel-password-enter *, #admin-password-enter, #admin-password-enter *, #poke-client-enter, #poke-client-enter *, #set-new-username-enter, #set-new-username-enter *, #client-info-container, #client-info-container *, #identity-string-use-container, #identity-string-use-container *, #secret-identity-string-container-enter, #secret-identity-string-container-enter * {
