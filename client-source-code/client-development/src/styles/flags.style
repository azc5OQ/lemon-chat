/* country flags - shared base set used by every theme. loaded always-on (see template.html),
   deliberately NOT in fonts.style or any single theme sheet. a theme may override any individual
   .country-flag-xx with its own image using !important (old-school does this with a pixel png set). */

        /* === country flags (shared across every theme; the old-school theme overrides each
           .country-flag-xx with its own image). the per-client flag div carries a country-flag-xx
           class, so flags come purely from css now - no inline background styles. === */
        .connected-client-country-flag {
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
        }

        /* server-settings tag/icon delete buttons (shared across every theme, always-on).
           the X stays hidden until its entry is hovered */
        .server-settings-tag-entry {
            position: relative;
        }
        .server-settings-icon-entry {
            position: relative;
            display: inline-block;
        }
        .settings-entry-delete-button {
            display: none;
            position: absolute;
            top: 0;
            right: 0;
            width: 16px;
            height: 16px;
            line-height: 14px;
            padding: 0;
            border: none;
            border-radius: 3px;
            background: #c0392b;
            color: #ffffff;
            font-size: 11px;
            cursor: pointer;
            z-index: 5;
        }
        .server-settings-tag-entry:hover .settings-entry-delete-button,
        .server-settings-icon-entry:hover .settings-entry-delete-button {
            display: block;
        }

        /* a tag's icon box is clickable to open the icon picker; it renders its icon when it has one and stays
           visible as a small bordered box when it does not */
        .tag-settings-entry-img {
            cursor: pointer;
            min-width: 16px;
            min-height: 16px;
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center;
            border: 1px solid #666;
        }

        /* icon picker popup: a centered, scrollable wrap of selectable icons */
        #tag-icon-picker-popup {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            max-width: 320px;
            max-height: 320px;
            overflow: auto;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 10px;
            background: #2b2b2b;
            border: 1px solid #555;
            border-radius: 6px;
            z-index: 10000;
        }
        .tag-icon-picker-option {
            width: 32px;
            height: 32px;
            object-fit: contain;
            cursor: pointer;
            border: 1px solid transparent;
            box-sizing: border-box;
        }
        .tag-icon-picker-option:hover {
            border-color: #7289da;
        }
        .tag-icon-picker-no-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #cccccc;
            font-size: 11px;
            background: #3a3a3a;
        }
