            }

            #textarea-log {
                position: absolute;
                z-index: 5;
                opacity: 0.5;
                display: none;
                width: 50%;
                height: 50%;
            }

            #custom-file-upload-button-image {
                background-image: url(data:image/png;base64,);
            }

            .custom-file-upload-button {
                display: inline-block;
                background-color: transparent;
                font-family: Tahoma, Arial, sans-serif;
                color: #1a1a1a;
                padding: 15px 1px 15px 15px;
                text-align: center;
                width: 15px;
                cursor: default;
                border-radius: 7px;
                transition: 0.3s ease;
                vertical-align: top;
                background-repeat: no-repeat;
                background-size: contain;
            }

            .button-1 {
                min-width: 58px;
                padding: 0 14px;
                font-size: 13px;
                font-weight: 600;
                letter-spacing: 0.3px;
                box-shadow: 0 2px 10px rgba(61, 122, 200, 0.4);
                width: 58px;
                height: 21px;
                border: 1px solid #b8cce0;
                transition: 0.3s ease;
                border-radius: 3px;
                color: #1a1a1a;
                cursor: default;
                background: linear-gradient(180deg, #f0f5fc 0%, #d8e8f8 100%);
                vertical-align: top;
            }

            #current-channel-description {
                font-size: 12px;
                padding: 12px 10px;
                border-bottom: 1px solid rgba(61, 122, 200, 0.08);
                word-break: break-all;
                font: 12px sans-serif;
                font-style: italic;
                color: #1a1a1a;
                height: 100%;
                text-align: center;
                padding-top: 12px;
            }

            #current-client-description {
                word-break: break-all;
                font: 12px sans-serif;
                font-style: italic;
                color: #1a1a1a;
                height: 100%;
                display: none;
                padding-left: 15px;
            }

            .custom-file-upload-button:hover {
                background-color: #7d8799;
            }

            .custom-file-upload-button:active {
                box-shadow: 0px 1px 0px #016DB0;
            }

            #upload-image-container {
                display: inline-block;
                vertical-align: top;
            }

            #play-pause-song-container {
                display: inline-block;
                vertical-align: top;
                visibility: hidden;
            }

            #identity-string-use-textarea {
                width: 90%;
                height: 138px;
                resize: none;
                border-radius: 5px;
                padding: 6px;
                color: #8e1ed2;
                font-family: Tahoma, Arial, sans-serif;
                border: 0px;
                font-size: 16px;
                background: #ffffff;
            }

            #custom-file-upload-button-song {
                background-image: url(data:application/octet-stream;base64,)
            }

            .text-input-pretty {
                font-size: 14px;
                border: none;
                border-radius: 3px 3px 0 0;
                transition: border-color 0.2s, background-color 0.2s;
                letter-spacing: 0.2px;
                padding: 5px;
                font-family: Tahoma, Arial, sans-serif;
                width: 200px;
                border-bottom: 2px solid #3d7ac8;
                border-left-color: #e0e0e0;
                border-right-color: #e0e0e0;
                border-top-color: #e0e0e0;
                background-color: #ffffff;
                border-top-style: solid;
                border-left-style: solid;
                border-right-style: solid;
                color: #1a1a1a;
            }

            #import-identity-button {
                width: 29px !important;
                background-image: url(data:image/png;base64,);
                background-repeat: no-repeat;
                background-position: center center;
                background-size: 24px 24px;
            }

            .text-input-pretty[disabled] {
                padding: 5px;
                font-family: Tahoma, Arial, sans-serif;
                background-color: #eeeeee;
                border-style: solid;
                color: #888888;
                width: 50px;
                border-bottom-color: #c0c0c0;
            }

            #poke-client-enter, #set-new-username-enter {
                top: 25%;
                width: 322px;
                height: 138px;
                background-color: #f0f0f0;
                margin: 0 auto;
                border-radius: 13px;
                overflow: hidden;
            }

            #poke-client-input-container, #set-new-username-input-container{
                height: 69px;
                text-align: center;
            }

            .text-input-pretty:focus {
                border-bottom-color: #2060a8;
                background-color: #f4f8ff;
                outline: none;
            }

            .text-input-not-pretty {
                padding: 5px;
                font-family: Tahoma, Arial, sans-serif;
                width: 185px;
                border-bottom: 2px solid #3d7ac8;
                border-left-color: #e0e0e0;
                border-right-color: #e0e0e0;
                border-top-color: #e0e0e0;
                background-color: #ffffff;
                border-top-style: solid;
                border-left-style: solid;
                border-right-style: solid;
                color: #1a1a1a;
            }

            .text-input-not-pretty[disabled] {
                padding: 5px;
                font-family: Tahoma, Arial, sans-serif;
                background-color: #eeeeee;
                border-style: solid;
                color: #888888;
                width: 67px;
                border-bottom-color: #c0c0c0;
            }

            .text-input-not-pretty-2 {
                padding: 5px;
                font-family: Tahoma, Arial, sans-serif;
                width: 172px;
                border-bottom: 2px solid #3d7ac8;
                border-left-color: #e0e0e0;
                border-right-color: #e0e0e0;
                border-top-color: #e0e0e0;
                background-color: #ffffff;
                border-top-style: solid;
                border-left-style: solid;
                border-right-style: solid;
                color: #1a1a1a;
            }

            .text-input-not-pretty-2[disabled] {
                padding: 5px;
                font-family: Tahoma, Arial, sans-serif;
                background-color: #eeeeee;
                border-style: solid;
                color: #888888;
                width: 80px;
                border-bottom-color: #c0c0c0;
            }

            .text-input-not-pretty:focus, .text-input-not-pretty-2:focus {
                border-bottom-color: #2060a8;
                background-color: #f4f8ff;
                outline: none;
            }

            #show-hide-log-button {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 0.5px;
                position: absolute;
                z-index: 11;
                bottom: 0;
                right: 0;
                width: 38px;
                height: 22px;
                border: 0px;
                transition: 0.3s ease;
                border-radius: 3px;
                color: #1a1a1a;
                cursor: default;
                background: #7d8799;
            }

            #enter-server-settings {
                display: none;
                position: absolute;
                z-index: 1;
                top: 0;
                right: 254px;
                width: 25px;
                height: 99%;
                border: 0px;
                transition: 0.3s ease;
                border-radius: 3px;
                cursor: default;
                background-image: url(data:image/png;base64,);
                background-repeat: no-repeat;
                background-position: center center;
                background-color: transparent;
                background-size: 16px 16px;
            }

            #choose-theme-button:hover + #choose-theme-button-list, #choose-theme-button + #choose-theme-button-list:hover {
                display: block;
                transition: 0.3s ease;
            }

            #choose-theme-button + #choose-theme-button-list > .choose-theme-item:hover {
                display: block;
                background-color: #f0f0f0;
            }

            #choose-theme-button-list {
                background: #ffffff;
                border: 1px solid rgba(61, 122, 200, 0.18);
                border-radius: 10px;
                padding: 4px;
                box-shadow: 0 6px 28px rgba(0, 0, 0, 0.55);
                min-width: 110px;
                display: none;
                position: absolute;
                z-index: 1;
                top: 24px;
                right: 200px;
                font: 16px sans-serif;
                font-family: 'Raleway';
                cursor: default;
            }

            .chat-context-selector {
                background-color: rgba(61, 122, 200, 0.1) !important;
                border-bottom: none;
                transition: background-color 0.12s;
                display: inline-block;
                min-height: 6px;
                height: 15px;
                padding: 4px;
                border-radius: 3px;
                margin-left: 1px;
                margin-right: 1px;
                cursor: default;
            }

            .chat-context-selector:hover .remove-chat-context-selector {
                visibility: visible;
            }

            .chat-context {
                overflow-x: hidden;
            }

            .chat-context-selector .p-container {
                font-weight: 600;
                letter-spacing: 0.2px;
                display: inline-block;
                vertical-align: top;
                font-size: 12px;
                font-family: Tahoma, Arial, sans-serif;
                min-width: 35px;
                color: #1a1a1a;
            }

            .remove-chat-context-selector {
                height: 14px;
                width: 14px;
                display: inline-block;
                cursor: default;
                visibility: hidden;
            }

            .remove-chat-context-selector:hover {
                background-image: url(data:application/octet-stream;base64,);
                background-repeat: no-repeat;
                background-size: 14px 14px;
                background-color: #f0f0f0;
            }

            #chat-window-container {
                display: inline-block;
                width: 100%;
                vertical-align: top;
                height: 95%;
                border-left: 1px solid #828790;
            }

            #background-container {
                position: absolute;
                width: 100%;
                height: 100%;
                background-color: #000010;
                z-index: 1;
                opacity: 0.5;
                top: 0px;
                display: none !important;
                text-align: center;
            }

            #identity-string-use-container {
                position: absolute;
                width: 100%;
                height: 100%;
                top: 0px;
                display: none;
                z-index: 5;
            }

            #identity-string-use-container-enter {
                top: 25%;
                width: 380px;
                height: 281px;
                background-color: #f0f0f0;
                margin: 0 auto;
                border-radius: 13px;
                overflow: hidden;
            }

            #poke-client-enter-container, #set-new-username-enter-container, #channel-properties-edit-container, #channel-password-enter-container, #admin-password-enter-container, #secret-identity-string-container, #client-info-container {
                position: absolute;
                width: 100%;
                height: 100%;
                top: 0px;
                display: none;
                z-index: 5;
            }

            #client-info-enter {
                top: 25%;
                width: 360px;
                background-color: #ffffff;
                border: 1px solid #c0ccd8;
                margin: 0 auto;
                border-radius: 13px;
                overflow: hidden;
                padding-bottom: 10px;
            }

            #client-info-content {
                padding: 6px 18px 4px 18px;
                color: #1a1a1a;
                font-family: Tahoma, Arial, sans-serif;
                font-size: 14px;
            }

            .client-info-row {
                padding: 4px 0px;
                word-break: break-all;
            }

            .client-info-label {
                display: inline-block;
                width: 95px;
                color: #5a6675;
            }

            .client-info-identity {
                font-size: 11px;
                color: #3a4350;
            }

            #secret-identity-string-container-enter {
                color: #1a1a1a;
                height: 274px !important;
            }

            #poke-client-enter-container-enter, #channel-properties-edit, #channel-password-enter, #admin-password-enter, #secret-identity-string-container-enter {
                top: 25%;
                width: 322px;
                height: 219px;
                background-color: #f0f0f0;
                margin: 0 auto;
                border-radius: 13px;
                overflow: hidden;
            }

            #chat-input-font-size-range {
                position: absolute;
                width: 52px;
                height: 4px;
                bottom: 9px;
                left: 21px;
                z-index: 6;
                opacity: 0.1;
            }

            #chat-input-font-size-range:hover {
                opacity: 1;
            }

            #toggle-microphone {
                position: absolute;
                display: none;
            }

            #microphone-push-to-talk-button-touch-device {
                display: none;
            }

        .button-1,
        #chat-input-container-send-chat-input,
        #stop-song,
        #show-hide-log-button,
        .custom-file-upload-button,
        #add-new-tag-to-server-button,
        #custom-file-upload-button-icon,
        .chat-message-context-menu-items p {
            color: #1a1a1a !important;
        }

        #drag-resize-chat:hover {
            border-left-color: rgba(36, 163, 190, 0.45);
            cursor: resize;
            border-left: 2px solid #3d7ac8;
        }

        .channel-list-context-menu-background,
        .chat-input-container-context-menu-background,
        .add-tag-context-menu-background {
            background: linear-gradient(180deg, #f8f8f8 0%, #f0f0f0 100%);
            border: 1px solid #c0c8d8;
        }

        .channel-list-context-menu-items p,
        .channel-list-context-menu-items label,
        .chat-input-container-context-menu-items p,
        .chat-input-container-context-menu-items label,
        .add-tag-context-menu-items p,
        .add-tag-context-menu-item {
            color: #1a1a1a;
        }

        .channel-list-context-menu-items p:hover,
        .channel-list-context-menu-items label:hover,
        .chat-input-container-context-menu-items p:hover,
        .add-tag-context-menu-items p:hover,
        .add-tag-context-menu-item:hover {
            background-color: #d0e4f8;
            color: #1a3060;
        }
        #server-settings-tab-icons-container,
        #server-settings-tab-tags-container {
            height: calc(100% - 46px);
            overflow: auto;
            background-color: #f4f4f4;
        }
        #server-settings-tab-upload-icon-file-input-container,
        #server-settings-tab-add-tag-details-container {
            height: 46px;
            text-align: left;
            background-color: #eaeef4;
        }
        #hide-chat-button:hover,
        #chat-input-container-send-chat-input:hover,
        #show-secret-identity-string:hover,
        #show-admin-password-entry:hover,
        #hide-show-flags-button:hover,
        #show-hide-log-button:hover,
        #clear-chat-button:hover,
        #enter-server-settings:hover,
        #microphone-always-broadcasting-audio-button:hover,
        #sound-effects-button:hover {
            background-color: rgba(61,122,200,0.18);
        }

        #poke-client-enter, #set-new-username-enter,
        #poke-client-enter-container-enter,
        #channel-properties-edit, #channel-password-enter,
        #admin-password-enter, #secret-identity-string-container-enter,
        #identity-string-use-container-enter {
            background-color: #f8f8f8;
            border: 1px solid #c0c0c0;
            box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        }
        #chat-input-container-text-input[disabled] {
            background-color: #f0f0f0;
        }

        .single-chat-message {
            font-size: 14px;
            line-height: 1.55;
            padding: 3px 14px;
            transition: background-color 0.1s;
            background-color: inherit;
            border-radius: 9px;
            font-family: Tahoma, Arial, sans-serif;
            width: 94%;
            min-height: 44px;
            margin: 0px;
            color: #1a1a1a;
        }
        .single-chat-message:hover {
            background-color: rgba(61,122,200,0.04);
        }

        .server-settings-tab-li {
            font-size: 13px;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 4px;
            transition: color 0.15s, background-color 0.15s;
            cursor: default;
            color: #444444;
        }
        .server-settings-tab-li:hover {
            color: #1a3060;
            background-color: #d0e4f8;
        }

        #choose-theme-button {
            font-size: 11px;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            position: absolute;
            z-index: 1;
            right: 200px;
            width: 49px;
            height: 99%;
            background-color: transparent;
            border: 0px;
            transition: 0.3s ease;
            border-radius: 3px;
            cursor: default;
            background-repeat: no-repeat;
            background-position: center center;
            background-size: 24px 24px;
            font-family: Codystar !important;
            font-weight: bold;
            color: #333333;
        }

        #color-picker-selector-div {
            position: absolute;
            bottom: 4px;
            left: 3px;
            width: 15px;
            height: 15px;
            z-index: 5;
            transition: 0.3s ease;
            border-radius: 4px;
            cursor: url(data:image/png;base64,), auto
            background-color: #3d7ac8;
        }

        .add-tag-context-menu-items::-webkit-scrollbar-track,
        .chat-input-container-context-menu-items::-webkit-scrollbar-track,
        #channel-list-container::-webkit-scrollbar-track,
        #chat-context-container::-webkit-scrollbar-track,
        #chat-input-container-text-input::-webkit-scrollbar-track,
        body::-webkit-scrollbar-track {
            background: #e8e8e8;
        }

        .connected-client-p-received-messages-number {
            display: none;
            float: right;
            font-size: 0.8em;
            padding-top: 0.2em;
            padding-left: 0.5em;
            padding-right: 0.5em;
            padding-bottom: 0.2em;
            border-radius: 14px;
            bottom: 0.1em;
            background-color: #3d7ac8;
            color: #ffffff;
        }

        #p-secret-identity-string {
            font-family: Tahoma, Arial, sans-serif;
            font-size: 13px;
            padding: 8px;
            width: 302px;
            word-break: break-word;
            color: #1a5a20;
        }

        #space-devider-42 {
            display: inline-block;
            width: 13%;
            height: 100%;
            white-space: normal;
            background: #eaeef2;
            border-left: 1px solid #c8d0d8;
        }

        .tag-head-p, .tag-settings-entry-p {
            color: #444444;
        }

        .marquee-music-playing-container > p,
        .marquee div {
            color: #2a5a98;
        }

        .client-description-tag-entry-name {
            width: calc(100% - 30px);
            display: inline-block;
            vertical-align: top;
            font-style: normal;
            font-size: 14px;
            color: #1a1a1a;
        }
        #current-client-description-client-name {
            font-weight: 700;
            padding: 7px;
            font-family: Tahoma, Arial, sans-serif;
            font-size: 15px;
            font-style: normal;
            color: #1a7800;
        }

        #toggle-microphone-label {
            background: rgba(61, 122, 200, 0.1);
            border: 1px solid rgba(36, 163, 190, 0.25);
            display: none;
            position: absolute;
            bottom: 0px;
            left: 0px;
            width: 40px;
            border-radius: 7px;
            height: 40px;
            transition: all 0.3s;
            background-repeat: no-repeat;
            cursor: default;
            background-size: 32px 32px;
            background-position: center;
            background-image: url(data:image/png;base64,);
            background-color: #e0e8f0;
        }
        #toggle-microphone-label:hover {
            background: rgba(36, 163, 190, 0.24);
            background-color: #c8d8ec;
        }
        #toggle-microphone:checked + #toggle-microphone-label {
            background: linear-gradient(135deg, rgba(36, 163, 190, 0.55) 0%, rgba(20, 120, 145, 0.55) 100%);
            border-color: #3d7ac8;
            box-shadow: 0 0 12px rgba(36, 163, 190, 0.4);
            background-color: #3d7ac8;
        }

        html {
            height: 100%;
            width: 100%;
            margin: 0px;
            background: #d4d0c8;
        }

        body {
            min-height: 100%;
            margin: 0px;
            overflow: hidden;
            color: #000000;
        }

        body, input, button, textarea, select, p, li, label {
            font-family: Tahoma, "Segoe UI", Arial, sans-serif;
            font-size: 11px;
        }

        #space-devider1 {
            width: 15%;
            display: inline-block;
            vertical-align: top;
            height: 100%;
            overflow-x: hidden;
            overflow-y: hidden;
            min-width: 100px;
            background: #ffffff;
            border-right: 2px solid #828790;
        }

        #channel-list-container {
            background-color: inherit;
            color: #1a1a1a;
            height: calc(100% - 30px);
            font-family: Tahoma, Arial, sans-serif;
            display: inline-block;
            vertical-align: top;
            width: 100%;
            overflow-y: auto;
            overflow-x: hidden;
            margin-bottom: 30px;
            background: #ffffff;
        }

        #idle-clients-container {
            height: 30%;
            overflow-x: hidden;
            overflow-y: auto;
            display: none;
            border-top: 1px solid #b6b6b6;
        }

        .single-channel:hover {
            background-color: #cce4ff;
            color: #000000;
        }

        .connected-client-p {
            display: inline-block;
            vertical-align: top;
            font-family: Tahoma, Arial, sans-serif;
            color: #000000;
            font-size: 11px;
            margin-top: 0;
        }

        #space-devider2 {
            display: inline-block;
            vertical-align: top;
            height: 100%;
            width: 73%;
            left: -4px;
            background: #ffffff;
        }

        #chat-context-container {
            display: inline-block;
            vertical-align: top;
            width: 100%;
            overflow-y: auto;
            overflow-x: hidden;
            height: 100%;
            background: #ffffff;
        }

        #chat-context-selectors-container {
            padding: 5px 6px 0 6px;
            min-height: 28px;
            padding-left: 25px;
            border-bottom: 1px solid #828790;
        }

        .single-chat-message-content {
            padding-top: 3px;
            max-width: 943px;
            word-break: break-all;
            color: #000000;
            font-size: 11px;
        }

        .single-chat-message-sender-username-container,
        .single-chat-message-sender-local-username-container {
            color: #00309c;
            font-size: 11px;
            font-weight: bold;
        }

        .single-chat-message-sender-time {
            display: inline-block;
            vertical-align: middle;
            font-style: italic;
            font-family: Tahoma, Arial, sans-serif;
            font-weight: bold;
            color: #808080;
            font-size: 10px;
        }

        #communication-system-head-menu {
            min-height: 30px;
            background-color: #f0f0f0;
            text-align: right;
            background: #ece9d8;
            border-bottom: 1px solid #828790;
            color: #000000;
        }

        .button-1,
        #chat-input-container-send-chat-input,
        #save-server-settings-button {
            background: linear-gradient(180deg, #fdfdfd 0%, #e2e2e2 100%);
            color: #000000;
            border: 1px solid #8e8e8e;
            border-radius: 3px;
            box-shadow: none;
            font-weight: normal;
            font-size: 11px;
        }

        #server-settings-tab {
            color: #1a1a1a;
            position: absolute;
            z-index: 2;
            display: none;
            width: 50%;
            min-width: 750px;
            min-height: 400px;
            height: 50%;
            background-color: #f0f0f0;
            opacity: 0.92;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
            background: #ece9d8;
        }

        #server-settings-tab-subcontainer {
            display: inline-block;
            width: 172px;
            height: 100%;
            vertical-align: top;
            font-family: 'Kavoon';
            cursor: move;
            background-color: #e0e8f0;
            background: #ece9d8;
            color: #000000;
        }

        #server-settings-tab-subcontainer2 {
            display: inline-block;
            width: calc(100% - 187px);
            height: 100%;
            font-family: 'Raleway';
            background: #ffffff;
        }

        #server-settings-general-settings-container,
        #server-settings-bans-container {
            background: #ffffff;
            color: #000000;
        }

        .single-channel-name-p {
            display: inline-block;
            font-size: 11px;
            font-weight: normal;
            letter-spacing: 0;
            color: #000000;
            background-image: url("data:image/svg+xml;base64,");
            background-repeat: no-repeat;
            background-position: 0px center;
            background-size: 14px 14px;
            padding-left: 19px;
        }

        .single-channel-name-p.single-channel-is-using-password {
            background-image: url("data:image/svg+xml;base64,");
            background-size: 14px 14px;
            padding-left: 19px !important;
        }

        .single-channel-name-p.single-channel-is-full {
            background-image: url("data:image/svg+xml;base64,");
            background-size: 14px 14px;
            padding-left: 19px !important;
        }

        .client-audio-state-microphone-active {
            background-image: url("data:image/svg+xml;base64,");
        }

        .client-audio-state-microphone-enabled {
            background-image: url("data:image/svg+xml;base64,");
        }

        .client-audio-state-microphone-disabled {
            background-image: url("data:image/svg+xml;base64,");
        }

        .single-channel-collapse-button,
        .single-channel-expand-button,
        .single-channel-collapse-button:hover,
        .single-channel-expand-button:hover {
            width: 16px !important;
            height: 16px !important;
            background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMDAlIiBoZWlnaHQ9IjEwMCUiIHZpZXdCb3g9IjAgMCAxNiAxNiI+PHBhdGggZD0iTTQgNiBMOCAxMC41IEwxMiA2IiBmaWxsPSJub25lIiBzdHJva2U9IiM1NTU1NTUiIHN0cm9rZS13aWR0aD0iMi40IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=") !important;
            background-repeat: no-repeat !important;
            background-position: center !important;
            background-size: 13px 13px !important;
            background-color: transparent !important;
            border-radius: 0 !important;
            vertical-align: middle !important;
            cursor: default !important;
        }
        .single-channel-expand-button,
        .single-channel-expand-button:hover {
            background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMDAlIiBoZWlnaHQ9IjEwMCUiIHZpZXdCb3g9IjAgMCAxNiAxNiI+PHBhdGggZD0iTTYgNCBMMTAuNSA4IEw2IDEyIiBmaWxsPSJub25lIiBzdHJva2U9IiM1NTU1NTUiIHN0cm9rZS13aWR0aD0iMi40IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=") !important;
        }

