@supports (-moz-appearance: none) {
            * {
                scrollbar-width: thin;
                scrollbar-color: rgba(0, 0, 0, 0.3) transparent;
            }
        }

        #container-2 {
            display: inline-block;
            border-radius: 16px;
            padding: 28px 36px 28px 36px;
            text-align: center;rgba(11, 10, 10, 0.15)
        }

        #create-channel-button {
            width: 72px;
        }

        #another-buttons-loading-container-p {
            font-size: 12px;
            color: #888888;
            letter-spacing: 0.8px;
        }

        .button-1:hover {
            background: linear-gradient(180deg, #e8f2ff 0%, #c8dcf4 100%);
            box-shadow: 0 4px 16px rgba(61, 122, 200, 0.35);
            transform: translateY(-1px);
        }

        #chat-input-container-send-chat-input:hover {
            background: linear-gradient(180deg, #e8f2ff 0%, #c8dcf4 100%) !important;
            box-shadow: 0 4px 16px rgba(61, 122, 200, 0.35);
            transform: translateY(-1px);
        }

        #hide-chat-button, #clear-chat-button, #show-admin-password-entry,
        #show-secret-identity-string, #microphone-always-broadcasting-audio-button,
        #hide-show-flags-button, #sound-effects-button, #enter-server-settings {
            background-color: transparent !important;
            transition: background-color 0.15s ease;
        }

        #hide-chat-button:hover, #clear-chat-button:hover, #show-admin-password-entry:hover,
        #show-secret-identity-string:hover, #microphone-always-broadcasting-audio-button:hover,
        #hide-show-flags-button:hover, #sound-effects-button:hover, #enter-server-settings:hover {
            background-color: #c0ccd8 !important;
        }

        #choose-theme-button:hover {
            background-color: rgba(61, 122, 200, 0.15) !important;
            color: #3d7ac8;
        }

        .choose-theme-item {
            padding: 7px 14px;
            font-size: 13px;
            color: #7d8fa0;
            border-radius: 6px;
            transition: background-color 0.12s, color 0.12s;
            cursor: default;
        }

        .choose-theme-item:hover {
            background-color: rgba(61, 122, 200, 0.15) !important;
            color: #d8e8f0;
        }

        .single-channel-collapse-button,
        .single-channel-expand-button {
            border-radius: 4px;
            transition: background-color 0.12s;
        }

        .single-channel-collapse-button:hover,
        .single-channel-expand-button:hover {
            background-color: rgba(61, 122, 200, 0.18);
        }

        .chat-context-selector:hover {
            background-color: rgba(61, 122, 200, 0.22) !important;
        }

        #channel-properties-input-container-enter {
            display: inline-block;
            vertical-align: top;
            width: 48%;
        }

        #chat-input-file-input-container:focus-within {
            border-color: #3d7ac8;
        }

        #channel-properties-edit,
        #channel-password-enter,
        #admin-password-enter,
        #poke-client-enter,
        #set-new-username-enter,
        #identity-string-use-container-enter,
        #secret-identity-string-container-enter {
            background: #f4f4f4;
            border: 1px solid rgba(61, 122, 200, 0.18);
            border-radius: 16px;
            box-shadow:
                0 16px 60px rgba(0, 0, 0, 0.75),
                0 0 0 1px rgba(61, 122, 200, 0.04);
        }

        .text-input-not-pretty,
        .text-input-not-pretty-2 {
            font-size: 11px;
            color: #1a1a1a;
            background-color: #ffffff;
            border-bottom-color: #3d7ac8;
            border-left-color: #e8e8e8;
            border-right-color: #e8e8e8;
            border-top-color: #e8e8e8;
            border-radius: 3px;
            transition: border-bottom-color 0.2s;
        }

        .text-input-not-pretty[disabled],
        .text-input-not-pretty-2[disabled] {
            color: #888888;
            background-color: #eeeeee;
            border-bottom-color: #c8c8c8;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        .channel-list-context-menu-items p:hover,
        .channel-list-context-menu-items label:hover,
        .chat-input-container-context-menu-items p:hover {
            background-color: rgba(61, 122, 200, 0.15);
            color: #1a1a1a;
        }

        #show-hide-log-button:hover {
            background: rgba(61, 122, 200, 0.35) !important;
            color: #1a1a1a;
        }

            * {
                margin: 0px;
                padding: 0px;
                position: relative;
            }

            #verification-system {
                min-height: 100vh;
                text-align: center;
            }

            div {
                position: relative;
            }

            #body-container {
                height: 100vh;
                min-width: 550px;
            }

            .marquee-music-playing-container {
                display: none;
                vertical-align: middle;
                white-space: nowrap;
                bottom: 3px;
            }

            a-toast
            {
                background: #f4f4f4 !important;
                border: 1px solid rgba(61, 122, 200, 0.4) !important;
                border-radius: 10px;
                color: #1a1a1a;
                font-size: 13px;
                font-weight: 500;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                position: fixed;
                left: 50%;
                transform: translate(-50%, -50%);
                z-index: 100;
                top: 40%;
                background-color: #FFF;
                min-width: 200px;
                border-width: 1px;
                vertical-align: top;
                padding: 10px;
                text-align: center;
                font-family: roboto,sans-serif;
                min-height: 20px;
                border-color: #7781b1;
                cursor: default;
            }

            a-toast:hover {
                background: rgba(61, 122, 200, 0.1) !important;
                background-color: grey;
            }

            .marquee-music-playing-container > p {
                display: inline-block;
                font-size: 13px;
                vertical-align: top;
                color: #7dffbd;
            }

            .client-mute-state {
                display: none;
                width: 20px;
                float: right;
                height: 20px;
                background-repeat: no-repeat;
                background-position: center center;
                background-size: 20px 20px;
                left: 3px;
                top: 1px;
                background-image: url(data:image/png;base64,);
            }

            .client-ignore-state {
                display: none;
                position: absolute;
                inset: 0;
                stroke: #fffa00;
                stroke-width: 4px;
                pointer-events: none;
                z-index: 2;
                height: 10px;
                top: 8px;
                left: 26px;
            }

            #android-settings-button {
                display: none;
            }

            .marquee {
                width: 100px;
                white-space: nowrap;
                overflow: hidden;
                display: inline-block;
                height: 15px;
                vertical-align: top;
            }

            .marquee div {
                padding-left: 100%;
                display: inline-block;
                font-family: roboto,sans-serif;
                font-size: 11px;
                vertical-align: top;
                color: #7ee8ff;
                padding-top: 2px;
                animation-duration: 40s;
                animation-timing-function: linear;
                animation-delay: 0s;
                animation-iteration-count: infinite;
                animation-direction: normal;
                animation-fill-mode: none;
                animation-play-state: running;
                animation-name: animate;
            }

            .chat-controls-container {
                display: inline-block;
                vertical-align: top;
                float: right;
                white-space: nowrap;
            }

            .p-marquee-song-icon {
                padding-left: 19px;
                background-image: url(data:image/png;base64,);
                background-repeat: no-repeat;
                background-size: 13px 15px;
            }

            .tag-head-p {
                display: inline-block;
                vertical-align: top;
                padding: 20px;
                color: #444444;
                width: 100px;
            }

            #custom-file-upload-button-icon {
                display: inline-block;
                padding: 4px 5px 0px 5px;
                text-align: center;
                width: 97px;
                height: 20px;
                font-family: 'Raleway', sans-serif;
                font-size: 13px;
                transition: 0.3s ease;
                border-radius: 3px;
                color: #1a1a1a;
                vertical-align: baseline;
                cursor: default;
                background: #7d8799;
            }

            #custom-file-upload-button-icon:hover {
                background-color: #f0f0f0;
            }

            .tag-head-p-container {
                white-space: nowrap;
            }

            .tag-settings-entry-p {
                display: inline-block;
                vertical-align: top;
                padding-top: 6px;
                padding-right: 20px;
                padding-left: 20px;
                color: #444444;
                width: 100px;
            }

            .tag-settings-entry-img {
                display: inline-block;
                vertical-align: top;
                padding-top: 6px;
                margin-left: 19px;
                color: #444444;
                width: 25px;
                height: 25px;
                background-repeat: no-repeat;
                background-size: 30px 30px;
            }

            @keyframes animate {
                100% {
                    transform: translate(-100%, 0);
                }
            }

            #space-devider-41
            {
                width: 25px;
                height: 20px;
                display: inline-block;
            }

            #drag-resize-chat {
                display: inline-block;
                height: 95%;
                vertical-align: top;
                border-left: 2px dashed transparent;
                cursor: ew-resize;
                width: 2px;
                -webkit-tap-highlight-color: transparent;
                -webkit-touch-callout: none;
                -webkit-user-select: none;
                -khtml-user-select: none;
                -moz-user-select: none;
                -ms-user-select: none;
                user-select: none;
            }

            #add-key-button {
                visibility: hidden;
            }

            .imgnotsentyet {
                opacity: 0.3 !important;
            }

            #spacer-between-chat-and-users {
                display: inline-block;
                vertical-align: top;
                width: 100%;
                overflow-y: auto;
                height: 100%;
            }

            .collapsed {
                display: none !important;
            }

            .chat-picture-img
            {
                max-width: 600px;
                background: inherit !important;
            }

            .chat-picture-img-default
            {
                width: 32px !important;
                height: 32px !important;
            }

            .local-client-chat-picture-img:hover {
                opacity: 0.8;
            }

            #current-client-avatar {
                border-radius: 50%;
                overflow: hidden;
                background-repeat: no-repeat;
                background-position: center center;
                background-image: url("data:image/gif;base64,");
            }

            .text-input-container {
                padding-top: 10px;
                padding-bottom: 10px;
            }

            .text-input-container-2 {
                padding-top: 4px;
                padding-bottom: 4px;
            }

            #stop-song {
                display: none;
                background-image: url(data:image/png;base64,);
                background-repeat: no-repeat;
                background-size: 24px 24px;
                height: 30px;
                width: 30px;
                background-position-x: center;
                background-position-y: center;
                background-color: #3d7ac8;
                transition: 0.3s ease;
                cursor: default;
            }

            #stop-song:hover {
                background-color: #7d8799;
            }

            .server-settings-tab-ul {
                background: #f0f0f0;
                border-bottom: 1px solid rgba(61, 122, 200, 0.15);
                padding: 14px;
            }

            #server-settings-tab-icons {
                height: 100%;
                display: block;
            }

            .client-description-tag-entry-icon {
                width: 18px;
                height: 18px;
                vertical-align: top;
                display: inline-block;
                background-repeat: no-repeat;
                background-position: center center;
                background-size: 18px 18px;
            }

            .single-channel-is-audio-disabled {
                height: 16px;
                margin-top: 3px;
                width: 16px;
                float: right;
                background-image: url(data:image/png;base64,);
                background-repeat: no-repeat;
            }

            .single-channel-is-using-password {
                display: inline-block;
                background-image: url(data:image/png;base64,);
                background-repeat: no-repeat;
                background-size: 20px 18px;
                padding-left: 24px !important;
            }

            .single-channel-is-temp {
                font-style: italic;
                color: #1a8f7a;
            }

            .single-channel-is-temp::after {
                content: " (temp)";
                font-size: 11px;
                opacity: 0.7;
            }

            #server-settings-general-settings-container {
                height: 100%;
                box-sizing: border-box;
                padding: 18px;
                background-color: #eaeef4;
                color: #1a1a1a;
                text-align: left;
                font-family: 'Raleway', sans-serif;
                overflow-y: auto;
            }

            .server-settings-general-header {
                margin: 0 0 14px 0;
                font-family: 'Raleway', sans-serif;
                font-size: 16px;
                font-weight: 600;
                color: #1a1a1a;
            }

            .server-settings-general-row {
                display: flex;
                align-items: center;
                gap: 10px;
                width: fit-content;
                margin-bottom: 12px;
                font-family: 'Raleway', sans-serif;
                font-size: 14px;
                color: #1a1a1a;
                cursor: default;
            }

            .server-settings-general-row input[type="checkbox"] {
                flex-shrink: 0;
                width: 16px;
                height: 16px;
                margin: 0;
                accent-color: #3d7ac8;
                cursor: default;
            }

            #server-settings-bans-header {
                margin-top: 22px;
            }

            .ban-entry {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                padding: 8px 0;
                border-bottom: 1px solid #c0ccd8;
            }

            .ban-entry-info {
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            .ban-entry-ip {
                color: #1a1a1a;
                font-weight: 600;
                font-size: 13px;
            }

            .ban-entry-meta {
                color: #5a6675;
                font-size: 11px;
            }

            .ban-entry-identity {
                color: #7a8595;
                font-size: 10px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                max-width: 240px;
            }

            .ban-entry-remove {
                flex-shrink: 0;
                padding: 4px 10px;
                background-color: #c0392b;
                color: white;
                border-radius: 5px;
                font-size: 12px;
                cursor: default;
                user-select: none;
            }

            .ban-entry-remove:hover {
                background-color: #d44637;
            }

            .ban-entry-empty {
                color: #5a6675;
                font-size: 13px;
            }

            #save-server-settings-button {
                display: inline-block;
                margin-top: 10px;
                padding: 7px 14px;
                border: 0px;
                border-radius: 3px;
                font-family: 'Raleway', sans-serif;
                font-size: 13px;
                color: #1a1a1a;
                cursor: default;
                transition: 0.3s ease;
                background: #7d8799;
            }

            #save-server-settings-button:hover {
                background-color: #f0f0f0;
            }

            #server-settings-tab-tags {
                display: none;
                height: 100%;
            }

            #server-settings-tab-general-settings {
                display: none;
                height: 100%;
            }

            #server-settings-tab-bans {
                display: none;
                height: 100%;
            }

            #server-settings-bans-container {
                height: 100%;
                box-sizing: border-box;
                padding: 18px;
                background-color: #ffffff;
                color: #1a1a1a;
                text-align: left;
                overflow-y: auto;
            }

            #server-settings-bans-list {
                max-height: 220px;
                overflow-y: auto;
                margin-top: 4px;
            }

            #add-new-tag-to-server-button {
                display: inline-block;
                padding: 2px 5px 9px 5px;
                text-align: center;
                width: 97px;
                border: 0px;
                height: 20px;
                font-family: 'Raleway', sans-serif;
                font-size: 13px;
                transition: 0.3s ease;
                border-radius: 3px;
                color: #1a1a1a;
                vertical-align: baseline;
                cursor: default;
                background: #7d8799;
            }

            #add-new-tag-to-server-button:hover {
                background-color: #f0f0f0;
            }

            #communication-system-container {
                height: 80%;
                display: none;
                min-width: 329px;
                white-space: nowrap;
            }

            .client-tags {

                float: right;
            }

            .connected-client-p-music-bot {
                color: #8abbbb !important;
            }

            .single-server-message {
                padding: 5px 20px;
                padding-left: 20px;
                padding-top: 5px;
                background-color: inherit;
                border-radius: 9px;
                color: #898e8c;
                font-family: Tahoma, Arial, sans-serif;
                font-size: 10px;
                margin: 0px;
                font-weight: bold;
                font-style: italic;
                word-wrap: break-word;
                width: 80%;
            }

            #admin-password-input-container {
                text-align: center;
            }

            #channel-password-input-container {
                height: 120px;
                text-align: center;
            }

            #channel-properties-input-container > div {
                vertical-align: top;
            }

            #connect-form-sub-container-1, #connect-form-sub-container-2 {
                display: inline-block;
                visibility: hidden;
            }

            #image-upload-preview {
                height: 70px;
                width: 85px;
                border-radius: 11px;
                display: none;
                background-repeat: no-repeat;
                background-position: center;
                background-size: 100% 100%;
            }

            #chat-input-file-input-container {
                border: 1px solid #c8d4e0;
                transition: border-color 0.2s;
                width: calc(100% - 175px);
                display: inline-block;
                vertical-align: top;
                padding: 0.5em;
                background-color: #ffffff;
                border-radius: 6px;
            }

            .single-tag {
                width: 20px;
                height: 17px;
                background-repeat: no-repeat;
                background-position: center center;
                background-size: 15px 15px;
                display: inline-block;
                padding-left: 2px;
                padding-right: 2px;
            }

            .padding-div {
                display: inline-block;
                vertical-align: top;
                height: 10px;
            }

            #contextmenus-container {
                position: absolute;
                z-index: 1;
                top: 0px;
                width: 0px;
                height: 0px;
            }

            .channel-list-context-menu, .chat-input-container-context-menu {
                background: #ffffff;
                border: 1px solid #c0ccd8;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                padding: 4px;
                position: absolute;
            }

            #channel-list-context-menu-background
            {
                border: 0px !important;  
            }


            .add-tag-context-menu {
                display: none;
                position: absolute;
                max-height: 285px;
                overflow-y: hidden;
            }

            .channel-list-context-menu-background, .chat-input-container-context-menu-background {
                background-color: #60656f;
                width: 130px;
                height: 156px;
                border-radius: 10px;
                opacity: 0.8;
                background: linear-gradient(180deg, #f4f4f4 0%, #e8e8e8 100%);
            }

            .add-tag-context-menu-background {
                background: linear-gradient(180deg, #f4f4f4 0%, #e8e8e8 100%);
                width: 130px;
                height: 100%;
                border-radius: 10px;
                opacity: 0.8;
                position: absolute;
            }

            .channel-list-context-menu-items {
                position: absolute;
                top: 0px;
                width: 130px;
                overflow: hidden;
                border-top-left-radius: 10px;
                border-top-right-radius: 10px;
            }

            .chat-input-container-context-menu-items {
                position: absolute;
                top: 0px;
                width: 130px;
                height: 154px;
                overflow-y: auto;
                overflow-x: hidden;
                border-top-left-radius: 10px;
                border-top-right-radius: 10px;
            }

            .context-menu-item-disabled {
                opacity: 0.7 !important;
                cursor: default !important;
            }

            .channel-list-context-menu-items p, .channel-list-context-menu-items label, .chat-input-container-context-menu-items p, .chat-input-container-context-menu-items label {
                border-radius: 6px;
                transition: background-color 0.12s, color 0.12s;
                color: #1a1a1a;
                top: 0px;
                width: 130px;
                font-size: 1em;
                font-family: Tahoma, Arial, sans-serif;
                padding: 5px;
                cursor: default;
                display: block;
            }

            .channel-list-context-menu-items p:hover, .channel-list-context-menu-items label:hover, .chat-input-container-context-menu-items p:hover, .chat-input-container-context-menu-items p:hover {
                background-color: #d0e4f8;
            }

            #channel-properties-disable-audio-checkbox {
                height: 25px;
                float: right;
            }

            .add-tag-context-menu-items {
                width: 136px;
                border-top-left-radius: 10px;
                border-top-right-radius: 10px;
                overflow-y: auto;
                height: 280px;
                overflow-x: hidden;
                border-radius: 10px;
            }

            .add-tag-context-menu-items p {
                color: #1a1a1a;
                display: block;
                background-repeat: no-repeat;
                background-size: 22px 22px;
                background-position: right center;
                background-position-x: 102px;
                font-size: 15px;
                font-family: Tahoma, Arial, sans-serif;
                padding-top: 5px;
                padding-bottom: 5px;
                cursor: default;
                white-space: nowrap;
            }

            .add-tag-context-menu-items p:hover {
                background-color: #d0e4f8;
            }

            .add-tag-context-menu-item {
                color: #1a1a1a;
                top: 0px;
                width: 130px;
                font-size: 1em;
                font-family: Tahoma, Arial, sans-serif;
                padding: 5px;
                cursor: default;
            }

            .add-tag-context-menu-item:hover {
                background-color: #d0e4f8;
            }

            .chat-message-context-menu-background {
                background-color: #60656f;
                width: 130px;
                height: 48px;
                opacity: 0.8;
            }

            .img-uploaded-icon {
                width: 32px;
                height: 32px;
                margin: 10px;
                vertical-align: top;
                display: inline-block;
                cursor: default;
                transition: 0.3s ease;
                border-radius: 5px;
            }

            .img-uploaded-icon:hover {
                background-color: #1a1a1a;
            }

            .chat-message-context-menu-items {
                position: absolute;
                top: 0px;
                width: 130px;
                overflow: hidden;
                background: #f0f4f8;
                border: 1px solid #c8d4e0;
                border-radius: 4px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.12);
            }

            .chat-message-context-menu-items p {
                color: #1a1a1a;
                top: 0px;
                width: 130px;
                font-size: 0.7em;
                font-family: Tahoma, Arial, sans-serif;
                padding: 5px;
                cursor: default;
                overflow: hidden;
            }

            .chat-message-context-menu-items p:hover {
                background-color: #d0e4f8;
            }

            .single-channel-collapse-button {
                width: 24px;
                height: 24px;
                display: inline-block;
                vertical-align: top;
                background-repeat: no-repeat;
                background-size: 24px 24px;
                background-image: url(data:image/png;base64,);
