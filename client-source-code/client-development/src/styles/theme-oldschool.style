        #channel-properties-input-container .text-input-not-pretty-2:not([disabled]),
        #channel-password-enter .text-input-not-pretty-2:not([disabled]),
        #admin-password-enter .text-input-not-pretty-2:not([disabled]),
        #poke-client-enter .text-input-not-pretty-2:not([disabled]),
