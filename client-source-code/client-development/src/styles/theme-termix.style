html {

    --tmx-darkest: #202225;
    --tmx-sidebar: #2b2d31;
    --tmx-main:    #313338;
    --tmx-input:   #383a40;
    --tmx-hover:   #35373c;
    --tmx-active:  #404249;
    --tmx-text:    #dbdee1;
    --tmx-muted:   #949ba4;
    --tmx-bright:  #f2f3f5;
    --tmx-accent:  #5865f2;
    --tmx-link:    #00a8fc;
    --tmx-green:   #23a55a;
    --tmx-danger:  #f23f43;
    --tmx-line:    #1f2023;

    height: 100%;
    width: 100%;
    margin: 0;
    background: var(--tmx-darkest);
}

body {
    min-height: 100%;
    margin: 0;
    overflow: hidden;
    color: var(--tmx-text);
    font-family: "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 14px;
    background: var(--tmx-main);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    position: relative;
}

#verification-system {
    background: var(--tmx-darkest);
    min-height: 100vh;
    text-align: center;
}

#container-2 {
    display: inline-block;
    background: var(--tmx-sidebar);
    border: 1px solid var(--tmx-line);
    border-radius: 10px;
    padding: 26px 34px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    text-align: center;
}

.text-input-pretty {
    width: 220px;
    padding: 9px 11px;
    font-size: 14px;
    color: var(--tmx-text);
    background: var(--tmx-darkest);
    border: 1px solid var(--tmx-line);
    border-radius: 5px;
    outline: none;
    transition: border-color 0.15s;
}
.text-input-pretty:focus {
    border-color: var(--tmx-accent);
}
.text-input-pretty[disabled] {
    color: var(--tmx-muted);
    background: #26282c;
}

#another-buttons-loading-container-p,
#another-buttons-sub-loading-container p {
    color: var(--tmx-muted);
}

.button-1,
#chat-input-container-send-chat-input,
#create-channel-button,
#edit-channel-button {
    height: 34px;
    min-width: 66px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
    background: var(--tmx-accent);
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.15s;
    vertical-align: top;
}
.button-1:hover,
#chat-input-container-send-chat-input:hover,
#create-channel-button:hover,
#edit-channel-button:hover {
    background: #4752c4;
}

#communication-system-head-menu {
    background: var(--tmx-darkest);
    border-bottom: 1px solid var(--tmx-line);
    min-height: 34px;
    height: 34px;
    color: var(--tmx-muted);
}

#choose-theme-button-list {
    background: var(--tmx-sidebar);
    border: 1px solid var(--tmx-line);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    padding: 4px;
}
.choose-theme-item {
    color: var(--tmx-text);
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
}
.choose-theme-item:hover {
    background: var(--tmx-accent);
    color: #ffffff;
}

#clear-chat-button, #hide-chat-button, #show-admin-password-entry, #show-secret-identity-string,
#microphone-always-broadcasting-audio-button, #hide-show-flags-button, #sound-effects-button,
#enter-server-settings, #layout-edit-button, #switch-identity-button, #choose-theme-button {
    background-color: transparent !important;
}
#hide-chat-button:hover, #show-secret-identity-string:hover, #show-admin-password-entry:hover,
#hide-show-flags-button:hover, #show-hide-log-button:hover, #clear-chat-button:hover,
#enter-server-settings:hover, #microphone-always-broadcasting-audio-button:hover,
#sound-effects-button:hover, #layout-edit-button:hover, #switch-identity-button:hover,
#choose-theme-button:hover {
    background-color: var(--tmx-hover) !important;
}

#connected-local-client-input {
    background-color: transparent;
    color: var(--tmx-bright);
    border: 0;
    outline: none;
    font-weight: 600;
}

#body-container {
    background: var(--tmx-main);
}

#communication-system-container {
    background: var(--tmx-main);
}

#space-devider1 {
    background: var(--tmx-sidebar);
}
#channel-list-container {
    background: transparent;
    color: var(--tmx-text);
    overflow-y: auto;
    overflow-x: hidden;
}
#idle-clients-container {
    background: transparent;
    border-top: 1px solid var(--tmx-line);
}

#space-devider2 {
    background: var(--tmx-main);
    left: 0;
}
#chat-window-container {
    background: var(--tmx-main);
}
#chat-context-container {
    background: var(--tmx-main);
}

#space-devider-42 {
    background: var(--tmx-sidebar);
}
#current-channel-description,
#current-client-description {
    color: var(--tmx-muted);
}
#current-client-description-client-name {
    color: var(--tmx-bright);
    font-weight: 600;
}

#space-devider4 {
    background: var(--tmx-main);
}

.single-channel {
    overflow: hidden;
    margin: 1px 8px;
    border-radius: 4px;
    min-height: 30px;
    line-height: 30px;
    color: var(--tmx-muted);
    cursor: pointer;
}
.single-channel:hover {
    background: var(--tmx-hover);
    color: var(--tmx-text);
}
.single-channel-name-p {
    color: inherit;
    font-size: 15px;
    font-weight: 500;
    vertical-align: middle;
}

.connected-client {
    overflow: hidden;
    margin: 1px 6px;
    padding: 2px 4px;
    border-radius: 4px;
    min-height: 26px;
    line-height: 22px;
}
.connected-client:hover {
    background: var(--tmx-hover);
}
.connected-client-p {
    color: var(--tmx-text);
    font-size: 14px;
    font-weight: 500;
    vertical-align: middle;
}
.connected-client-p-received-messages-number {
    color: #ffffff;
    background: var(--tmx-accent);
    border-radius: 8px;
    font-size: 10px;
    padding: 0 5px;
}

.single-server-message {
    color: var(--tmx-muted);
    font-size: 12px;
    font-style: italic;
    padding: 4px 16px;
}

.single-chat-message {
    background: transparent;
    color: var(--tmx-text);
    border-radius: 0;
    width: 100%;
    min-height: 0;
    margin: 0;
    padding: 2px 16px;
}
.single-chat-message:hover {
    background: rgba(0, 0, 0, 0.14);
}
.single-chat-message-sender-username-container {
    color: var(--tmx-bright);
    font-weight: 600;
    font-size: 14px;
}
.single-chat-message-sender-local-username-container {
    color: #949cf7;
    font-weight: 600;
    font-size: 14px;
}
.single-chat-message-sender-time {
    color: var(--tmx-muted);
    font-size: 11px;
    font-style: normal;
    vertical-align: middle;
    margin-left: 6px;
}
.single-chat-message-content {
    color: var(--tmx-text);
    font-size: 14px;
    line-height: 1.35;
    padding-top: 1px;
}

#chat-context-selectors-container {
    background: var(--tmx-darkest);
    border-bottom: 1px solid var(--tmx-line);
}
.chat-context-selector {
    background: var(--tmx-input) !important;
    border-radius: 4px;
    padding: 4px 10px;
    color: var(--tmx-muted);
}
.chat-context-selector:hover {
    background: var(--tmx-active) !important;
}
.chat-context-selector .p-container {
    color: var(--tmx-text);
}
#current-channel-name {
    color: var(--tmx-bright);
    font-weight: 600;
    font-size: 15px;
}

#chat-input-container-text-input {
    color: var(--tmx-text);
    background: var(--tmx-input);
    border: 0;
    border-radius: 8px;
    padding: 11px 14px;
    min-height: 44px;
    line-height: 1.4;
    outline: none;
    resize: none;
    caret-color: var(--tmx-text);
    font-family: inherit;
    font-size: 14px;
}
#chat-input-container-text-input::placeholder {
    color: var(--tmx-muted);
}
#chat-input-container-text-input[disabled] {
    background: #2a2c30;
    color: var(--tmx-muted);
}
#chat-input-file-input-container {
    background: transparent;
    border-radius: 8px;
    padding: 4px 8px;
}

#channel-properties-edit, #channel-password-enter, #admin-password-enter, #poke-client-enter,
#set-new-username-enter, #identity-string-use-container-enter, #secret-identity-string-container-enter,
#client-info-enter, #server-settings-tab {
    background: var(--tmx-sidebar);
    border: 1px solid var(--tmx-line);
    border-radius: 8px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
    color: var(--tmx-text);
}

#menu-bar-container {
    background: var(--tmx-darkest);
    border-bottom: 1px solid var(--tmx-line);
    height: 34px;
    padding: 2px 8px;
}
.dialog-title {
    color: var(--tmx-bright);
    font-weight: 600;
    line-height: 32px;
}

.text-input-not-pretty, .text-input-not-pretty-2 {
    color: var(--tmx-text);
    background: var(--tmx-darkest);
    border: 1px solid var(--tmx-line);
    border-radius: 4px;
}

#server-settings-tab-subcontainer {
    background: var(--tmx-darkest);
}
#server-settings-tab-subcontainer2 {
    background: var(--tmx-sidebar);
}
.server-settings-tab-li {
    color: var(--tmx-muted);
    border-radius: 4px;
    cursor: pointer;
}
.server-settings-tab-li:hover {
    background: var(--tmx-hover);
    color: var(--tmx-bright);
}

.identity-tag-chip {
    background: var(--tmx-input);
    color: var(--tmx-text);
}

::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}
::-webkit-scrollbar-track {
    background: var(--tmx-darkest);
}
::-webkit-scrollbar-thumb {
    background: #1a1b1e;
    border-radius: 4px;
    border: 2px solid var(--tmx-darkest);
}
::-webkit-scrollbar-thumb:hover {
    background: #141517;
}
::-webkit-scrollbar-corner {
    background: transparent;
}

@supports (-moz-appearance: none) {
    * {
        scrollbar-width: thin;
        scrollbar-color: #1a1b1e var(--tmx-darkest);
    }
}

#show-hide-log-button {
    background: var(--tmx-darkest);
    color: var(--tmx-muted);
    border: 0;
    border-radius: 4px 0 0 0;
}
#show-hide-log-button:hover {
    color: var(--tmx-bright);
}

#textarea-log {
    background: var(--tmx-darkest);
    color: var(--tmx-green);
    border: 1px solid var(--tmx-line);
    font-family: "Consolas", "Courier New", monospace;
}

#clear-chat-button {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-image: url(data:image/png;base64,);
    background-size: 21px 19px;
    background-repeat: no-repeat;
    background-color: transparent;
    background-position: center center;
}

#hide-chat-button {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 28px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-image: url(data:image/png;base64,);
    background-size: 21px 19px;
    background-repeat: no-repeat;
    background-position: center center;
    background-color: transparent;
}

#show-admin-password-entry {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 59px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-image: url(data:image/png;base64,);
    background-repeat: no-repeat;
    background-position: center center;
    background-color: transparent;
    background-size: 16px 16px;
}

#show-secret-identity-string {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 87px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-image: url(data:image/png;base64,);
    background-repeat: no-repeat;
    background-position: center center;
    background-color: transparent;
    background-size: 24px 24px;
}

#microphone-always-broadcasting-audio-button {
    display: block;
    position: absolute;
    z-index: 1;
    top: 0;
    right: 116px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-repeat: no-repeat;
    background-position: center center;
    background-color: black;
    background-size: 16px 16px;
    background-image: url(data:image/png;base64,);
}

#hide-show-flags-button {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 143px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-repeat: no-repeat;
    background-position: center center;
    background-color: transparent;
    background-size: 16px 16px;
    background-image: url(data:image/png;base64,);
}

#sound-effects-button {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 169px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-repeat: no-repeat;
    background-position: center center;
    background-color: transparent;
    background-size: 19px 19px;
    background-image: url(data:image/svg+xml;base64,);
}

#enter-server-settings {
    display: block;
    position: absolute;
    z-index: 1;
    top: 0;
    right: 284px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    background-image: url(data:image/png;base64,);
    background-repeat: no-repeat;
    background-position: center center;
    background-color: transparent;
    background-size: 16px 16px;
}

#choose-theme-button {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 200px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    font-size: 0;
    background-color: transparent;
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 18px 18px;
    background-image: url(data:image/png;base64,);
}

#layout-edit-button {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 228px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    font-size: 0;
    background-color: transparent;
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 18px 18px;
    background-image: url(data:image/png;base64,);
}

#switch-identity-button {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 256px;
    width: 25px;
    height: 99%;
    border: 0px;
    transition: 0.3s ease;
    border-radius: 3px;
    cursor: pointer;
    font-size: 0;
    background-color: transparent;
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 18px 18px;
    background-image: url(data:image/png;base64,);
}

#communication-system-container {
    display: none;
    min-width: 329px;
    white-space: nowrap;
}

#background-container {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 1;
    top: 0;
    display: none;
}
#poke-client-enter-container, #set-new-username-enter-container, #channel-properties-edit-container,
#channel-password-enter-container, #admin-password-enter-container, #secret-identity-string-container,
#identity-string-use-container, #client-info-container, #musicbot-management-background-container,
#adjust-volume-container {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 320;
    top: 0;
    display: none;
}

#server-settings-tab {
    position: absolute;
    z-index: 330;
    display: none;
    width: 50%;
    min-width: 750px;
    min-height: 400px;
    height: 50%;
}

#server-settings-tab-tags,
#server-settings-tab-general-settings,
#server-settings-tab-bans,
#server-settings-tab-identities {
    display: none;
}

#choose-theme-button-list {
    position: absolute;
    z-index: 1;
    top: 30px;
    right: 200px;
    display: none;
}
#choose-theme-button:hover + #choose-theme-button-list,
#choose-theme-button + #choose-theme-button-list:hover {
    display: block;
}

#idle-clients-container { display: none; }
#image-upload-preview { display: none; }
.client-mute-state { display: none; }
.client-ignore-state { display: none; }
.marquee-music-playing-container { display: none; }
#stop-song { display: none; }
#android-settings-button { display: none; }
#toggle-microphone { position: absolute; display: none; }
#toggle-microphone-label { display: none; }
#microphone-push-to-talk-button-touch-device { display: none; }
.add-tag-context-menu, .channel-list-context-menu, .chat-input-container-context-menu { display: none; }
.collapsed { display: none !important; }

#space-devider1 { padding-top: 8px; }
#channel-list-container { padding: 0 2px; }

.single-channel {
    overflow: hidden;
    margin: 1px 8px;
    padding: 3px 8px;
    border-radius: 4px;
    min-height: 0;
    line-height: 18px;
    color: var(--tmx-muted);
    cursor: pointer;
}
.single-channel:hover { background: var(--tmx-hover); color: var(--tmx-text); }
.padding-div {
    display: inline-block;
    vertical-align: middle;
    height: 1px;
}
.single-channel-collapse-button,
.single-channel-expand-button {
    display: inline-block;
    width: 14px;
    height: 16px;
    vertical-align: middle;
    cursor: pointer;
    color: var(--tmx-muted);
    font-size: 10px;
    line-height: 16px;
    text-align: center;
}
.single-channel-collapse-button::before { content: "\25be"; }
.single-channel-expand-button::before { content: "\25b8"; }
.single-channel-name-p {
    display: inline-block;
    color: inherit;
    font-size: 14px;
    font-weight: 500;
    vertical-align: middle;
}
.single-channel-name-p::before {
    content: "# ";
    color: var(--tmx-muted);
    font-weight: 400;
    opacity: 0.85;
}

.connected-client {
    overflow: hidden;
    margin: 0 8px 0 16px;
    padding: 2px 6px;
    border-radius: 4px;
    min-height: 0;
    line-height: 20px;
}
.connected-client:hover { background: var(--tmx-hover); }
.client-audio-state {
    display: inline-block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #5865f2;
    background-size: 12px 12px;
    background-position: center;
    background-repeat: no-repeat;
    vertical-align: middle;
    margin-right: 6px;
    box-shadow: 0 0 0 0 rgba(35,165,90,0);
    transition: box-shadow 0.1s ease;
}
.client-audio-state-microphone-active { box-shadow: 0 0 0 2px var(--tmx-green); }
.connected-client-p {
    display: inline-block;
    color: var(--tmx-muted) !important;
    font-size: 13px;
    font-weight: 500;
    vertical-align: middle;
    margin-top: 0;
}
.connected-client:hover .connected-client-p { color: var(--tmx-text) !important; }
.connected-client-country-flag { margin-top: 5px; }

#chat-context-selectors-container {
    background: var(--tmx-main);
    border-bottom: 1px solid var(--tmx-line);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    padding: 6px 12px;
    z-index: 2;
}
#current-channel-name::before {
    content: "# ";
    color: var(--tmx-muted);
    font-weight: 400;
}

#space-devider4 { padding: 0 16px 16px 16px; }
#chat-input-file-input-container {
    background: var(--tmx-input);
    border-radius: 8px;
    padding: 2px 12px;
}
#chat-input-container-text-input {
    background: transparent !important;
    border: 0;
    width: 100% !important;
    min-height: 22px;
    padding: 9px 2px;
    border-radius: 0;
}
#chat-input-font-size-range { display: none; }
#color-picker-selector-div { opacity: 0.7; }
.chat-controls-container { padding-top: 6px; }

a-toast {
    background-color: var(--tmx-input) !important;
    color: var(--tmx-text);
    border: 1px solid var(--tmx-line) !important;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}
a-toast:hover { background-color: var(--tmx-hover); }

@keyframes tmx-pop {
    from { opacity: 0; transform: scale(0.96); }
    to   { opacity: 1; transform: scale(1); }
}
@keyframes tmx-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
}

#channel-properties-edit, #channel-password-enter, #admin-password-enter, #poke-client-enter,
#set-new-username-enter, #identity-string-use-container-enter, #secret-identity-string-container-enter,
#client-info-enter, #server-settings-tab {
    animation: tmx-pop 0.16s ease-out;
    transform-origin: center;
}

#background-container {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0, 0, 0, 0.72) !important;
    opacity: 1 !important;
    z-index: 300 !important;
}
a-toast { animation: tmx-pop 0.16s ease-out; }

.single-channel, .connected-client, .chat-context-selector, .single-chat-message,
.server-settings-tab-li, .choose-theme-item {
    transition: background-color 0.1s ease, color 0.1s ease;
}

#contextmenus-container > div,
.channel-list-context-menu, .chat-input-container-context-menu, .add-tag-context-menu {
    background: var(--tmx-darkest) !important;
    border: 1px solid var(--tmx-line);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
    padding: 6px;
    animation: tmx-pop 0.12s ease-out;
}
.context-menu-item,
.channel-list-context-menu-items p, .channel-list-context-menu-items label,
.chat-input-container-context-menu-items p, .chat-input-container-context-menu-items label {
    color: var(--tmx-text) !important;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
    transition: background-color 0.1s ease;
}
.context-menu-item:hover,
.channel-list-context-menu-items p:hover, .channel-list-context-menu-items label:hover,
.chat-input-container-context-menu-items p:hover {
    background: var(--tmx-accent);
    color: #ffffff !important;
}

#space-devider-42 { background: var(--tmx-sidebar); padding-top: 6px; }
#current-client-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: var(--tmx-accent);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 4px solid var(--tmx-sidebar);
    box-shadow: 0 0 0 1px var(--tmx-line);
    margin: 6px auto 6px auto;
    display: block;
}
#current-client-description > p {
    text-align: center;
    color: var(--tmx-muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}
#current-client-description-client-name {
    text-align: center;
    color: var(--tmx-bright) !important;
    font-size: 17px !important;
    font-weight: 700;
    text-transform: none !important;
    letter-spacing: 0 !important;
}

#contextmenus-container {
    position: absolute;
    z-index: 340;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    overflow: visible;
}
.channel-list-context-menu, .chat-input-container-context-menu,
.add-tag-context-menu, .chat-message-context-menu {
    position: absolute;
    min-width: 150px;
    white-space: nowrap;
}

#server-settings-tab {
    white-space: nowrap;
    overflow: hidden;
}
#server-settings-tab-subcontainer {
    display: inline-block;
    width: 172px;
    height: calc(100% - 35px);
    vertical-align: top;
    cursor: move;
}
#server-settings-tab-subcontainer2 {
    display: inline-block;
    width: calc(100% - 176px);
    height: calc(100% - 35px);
    vertical-align: top;
    white-space: normal;
    overflow: hidden;
}
.server-settings-tab-ul {
    padding: 10px 8px;
    list-style: none;
}
.server-settings-tab-li {
    padding: 6px 10px;
    margin: 2px 0;
    font-size: 14px;
}
#server-settings-tab-icons {
    display: block;
    height: 100%;
}
#server-settings-tab-icons-container, #server-settings-tab-tags-container {
    height: calc(100% - 46px);
    overflow: auto;
}

.chat-context-selector { display: none !important; }
.chat-context-selector[style*="background-color"] {
    display: block !important;
    background: transparent !important;
    padding: 2px 0;
}

#chat-context-selectors-container:not(:has(.chat-context-selector[style*="background-color"])) .chat-context-selector:last-child {
    display: block !important;
    background: transparent !important;
    padding: 2px 0;
}
.chat-context-selector .p-container {
    display: inline-block;
    vertical-align: middle;
}
.chat-context-selector .p-container p {
    color: var(--tmx-bright);
    font-weight: 600;
    font-size: 15px;
    display: inline-block;
}
.chat-context-selector[data-chat-context-selector-type="channel"] .p-container p::before {
    content: "# ";
    color: var(--tmx-muted);
    font-weight: 500;
}
.chat-context-selector[data-chat-context-selector-type="user"] .p-container p::before {
    content: "@ ";
    color: var(--tmx-muted);
    font-weight: 500;
}

.remove-chat-context-selector {
    display: inline-block;
    vertical-align: middle;
    margin-left: 8px;
    width: 14px;
    height: 14px;
    cursor: pointer;
    opacity: 0.5;
}
.remove-chat-context-selector:hover { opacity: 1; }
.remove-chat-context-selector::before {
    content: "\2715";
    display: block;
    font-size: 11px;
    line-height: 14px;
    text-align: center;
    color: var(--tmx-muted);
}
