cbuffer RootCB : register(b0) { float2 u_viewport; float2 _pad; };
struct VSIn {
    float2 pos      : POSITION;
    float4 color    : COLOR0;
    float2 local    : TEXCOORD0;
    float2 rect_sz  : TEXCOORD1;
    float  radius   : TEXCOORD2;
};
struct VSOut {
    float4 pos      : SV_POSITION;
    float4 color    : COLOR0;
    float2 local    : TEXCOORD0;
    float2 rect_sz  : TEXCOORD1;
    float  radius   : TEXCOORD2;
};

VSOut VSMain(VSIn v)
{
    VSOut o;
    float2 ndc = float2(
        (v.pos.x / u_viewport.x) * 2.0 - 1.0,
        1.0 - (v.pos.y / u_viewport.y) * 2.0
    );
    o.pos     = float4(ndc, 0.0, 1.0);
    o.color   = v.color;
    o.local   = v.local;
    o.rect_sz = v.rect_sz;
    o.radius  = v.radius;
    return o;
}

@RENDERER_SDF_ROUND_BOX_HLSL@

float4 PSMain(VSOut i) : SV_Target
{
    float2 half_size = i.rect_sz * 0.5;
    float2 p = i.local - half_size;
    float d = sd_round_box(p, half_size, i.radius);
    float aa = 1.0 - smoothstep(@RENDERER_SDF_AA_MIN@, @RENDERER_SDF_AA_MAX@, d);
    if (aa <= 0.0) discard;
    return float4(i.color.rgb, i.color.a * aa);
}
