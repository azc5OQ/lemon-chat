class Intent
{
    final java.util.Map<String, Object> extras = new java.util.HashMap<String, Object>();
    String action;
    static final int FLAG_ACTIVITY_NEW_TASK = 1;
    static final int FLAG_ACTIVITY_SINGLE_TOP = 2;
    String getAction()
    {
        return this.action;
    }
    void addFlags(int flags)
    {
    }
    void putExtra(String key, long value)
    {
        this.extras.put(key, value);
    }
    long getLongExtra(String key, long fallback)
    {
        return this.extras.containsKey(key) ? (Long)this.extras.get(key) : fallback;
    }
    Intent()
    {
    }
    Intent(Object context, Class<?> target)
    {
    }
    public void setAction(String value)
    {
        action = value;
    }
    public void putExtra(String key, int value)
    {
        extras.put(key, value);
    }
    public void putExtra(String key, String value)
    {
        extras.put(key, value);
    }
    public String getStringExtra(String key)
    {
        return (String) extras.get(key);
    }
    public int getIntExtra(String key, int fallback)
    {
        return extras.containsKey(key) ? (Integer) extras.get(key) : fallback;
    }
}
class AppCompatActivity
{
    Intent intent;
    Intent startedService;
    Intent startedActivity;
    final TextView callerView = new TextView();
    protected void onCreate(Bundle state)
    {
    }
    protected void onNewIntent(Intent replacement)
    {
        // Model framework delivery; application fields are not framework-managed extras.
    }
    protected void setContentView(int layout)
    {
    }
    protected Intent getIntent()
    {
        return intent;
    }
    protected void setIntent(Intent replacement)
    {
        intent = replacement;
    }
    @SuppressWarnings("unchecked")
    protected <T extends View> T findViewById(int id)
    {
        return (T)(id == R.id.content ? new ViewGroup() : callerView);
    }
    protected void startService(Intent request)
    {
        startedService = request;
    }
    protected void startActivity(Intent request)
    {
        this.startedActivity = request;
    }
    protected void finish()
    {
    }
    protected void finishAndRemoveTask()
    {
    }
}
