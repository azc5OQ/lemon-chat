class BackgroundService
{
    String activeCallId = "";
    String activeCallSession = "";
    long activeCallExpiry;
    static boolean suppressNextIdleExit;
    static final int INCOMING_CALL_NOTIFICATION_ID = 2;
    NotificationManager notificationManager = new NotificationManager();
    NodeBridge nodeBridge = new NodeBridge();
    WebView webView = new WebView();
    boolean isTrustedPage()
    {
        return true;
    }
__CURRENT_CALL__
__CALL_ACTION__
__CLEAR_CALL__
    static final String ACTION_ACCEPT_CALL = "accept-call";
    static final String ACTION_DECLINE_CALL = "decline-call";
}
