class Probe
{
    static void check(boolean result, String message)
    {
        if (!result)
        {
            throw new AssertionError(message);
        }
    }
    static Intent call(String caller, String id)
    {
        Intent intent = new Intent();
        intent.putExtra("callerName", caller);
        intent.putExtra("call_id", id);
        intent.putExtra("session_id", "session-A");
        intent.putExtra("expires_at", System.currentTimeMillis() + 30000);
        return intent;
    }
    public static void main(String[] args)
    {
        String oldId = "00000000000000000000000000000001";
        String newId = "00000000000000000000000000000002";
        IncomingCallActivity activity = new IncomingCallActivity();
        activity.setIntent(call("Maya", oldId));
        activity.onCreate(new Bundle());
        check("Maya".equals(activity.callerView.text), "first caller not displayed");
        activity.onNewIntent(call("Sam", newId));
        activity.onAcceptCall(new View());
        check("Sam".equals(activity.callerView.text), "new caller not displayed");
        check(activity.startedService == null && newId.equals(activity.startedActivity.getStringExtra("call_id")), "accept must launch activity with current capability");
        BackgroundService service = new BackgroundService();
        service.activeCallId = newId;
        service.activeCallSession = "session-A";
        service.activeCallExpiry = System.currentTimeMillis() + 30000;
        Intent old = call("Maya", oldId);
        old.setAction(BackgroundService.ACTION_ACCEPT_CALL);
        service.handleCallAction(old);
        check(service.nodeBridge.actions == 0 && service.activeCallId.equals(newId), "stale action changed current call");
        service.handleCallAction(activity.startedActivity);
        check(service.nodeBridge.actions == 1 && newId.equals(service.nodeBridge.lastId), "valid current action was not sent");
        service.handleCallAction(activity.startedActivity);
        check(service.nodeBridge.actions == 1, "duplicate call action sent twice");
        service.activeCallId = newId;
        service.activeCallExpiry = System.currentTimeMillis() - 1;
        service.handleCallAction(activity.startedActivity);
        check(service.nodeBridge.actions == 1, "expired capability accepted");
        service.activeCallExpiry = System.currentTimeMillis() + 30000;
        service.activeCallSession = "session-B";
        service.handleCallAction(activity.startedActivity);
        check(service.nodeBridge.actions == 1, "wrong session accepted");
        service.activeCallSession = "session-A";
        int canceledBeforeDisconnect = service.notificationManager.cancellations;
        service.clearIncomingCall();
        check(!service.isCurrentCall(newId, "session-A") && service.activeCallSession.isEmpty()
            && service.activeCallExpiry == 0 && service.notificationManager.cancellations == canceledBeforeDisconnect + 1,
            "Disconnected call remained actionable or displayed");
        service.handleCallAction(activity.startedActivity);
        check(service.nodeBridge.actions == 1, "Disconnected call submitted a native action");
        System.out.println("PASS: reused call screen refreshes caller/capability; activity-first acceptance; stale, duplicate, expired and wrong-session actions rejected");
    }
}
