class NodeBridge
{
    int actions;
    String lastId;
    void sendCallAction(String action, String callId, String sessionId)
    {
        this.actions++;
        this.lastId = callId;
    }
}
class NotificationManager
{
    int cancellations;
    void cancel(int id)
    {
        this.cancellations++;
    }
}
