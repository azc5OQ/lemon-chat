/* Website details sit below the message they came from. Use the chat's colors
   and keep long titles and pictures inside the available space on a phone. */
.chat-link-previews
{
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 6px 0 12px;
    max-width: 420px;
}

.chat-link-preview
{
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px 12px;
    border: 1px solid currentColor;
    border-left-width: 3px;
    border-radius: 6px;
    color: inherit;
    background: rgba(128, 128, 128, 0.08);
    text-decoration: none;
    overflow: hidden;
    overflow-wrap: anywhere;
    font: 14px/1.4 sans-serif;
}

.chat-link-preview:hover, .chat-link-preview:focus-visible
{
    background: rgba(128, 128, 128, 0.18);
}

.chat-link-preview-site_name
{
    font-size: 12px;
    opacity: 0.75;
}

.chat-link-preview-title
{
    font-weight: bold;
}

.chat-link-preview-description
{
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.chat-link-preview img
{
    display: block;
    width: 100%;
    max-height: 240px;
    object-fit: contain;
    border-radius: 3px;
    margin-top: 4px;
}
