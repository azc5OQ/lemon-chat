#server-settings-tab-emojis
{
    padding: 12px;
    color: var(--set-text, inherit);
    font: 12px var(--set-font, sans-serif);
}

#server-settings-tab-emojis :is(input, button)
{
    position: static;
    margin: 0;
    font: inherit;
    color: var(--set-field-text, inherit);
    background: var(--set-field, transparent);
    border: var(--set-field-border, 1px solid var(--set-line, #888));
    border-radius: var(--set-radius, 4px);
    min-height: 27px;
    padding: 4px 8px;
    max-width: 100%;
}

#server-settings-tab-emojis button,
#server-settings-tab-emojis input::file-selector-button
{
    cursor: default;
    font: inherit;
    color: var(--set-button-text, var(--set-accent-text, #fff));
    background: var(--set-button-bg, var(--set-accent, #5a8cff));
    border: var(--set-button-border, 1px solid transparent);
    border-radius: var(--set-radius, 4px);
    padding: 5px 10px;
}

#server-settings-tab-emojis button:hover:not(:disabled),
#server-settings-tab-emojis input::file-selector-button:hover
{
    filter: var(--set-button-hover-filter, brightness(1.14));
    background: var(--set-button-hover-bg, var(--set-button-bg, var(--set-accent, #5a8cff)));
    color: var(--set-button-hover-text, var(--set-button-text, var(--set-accent-text, #fff)));
    border: var(--set-button-hover-border, var(--set-button-border, 1px solid transparent));
}

#server-settings-tab-emojis button:active:not(:disabled)
{
    border: var(--set-button-border-active, var(--set-button-border, 1px solid transparent));
}

#server-settings-tab-emojis :disabled
{
    opacity: .55;
}

#server-emojis-upload-form,
.server-emojis-toolbar
{
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
}

#server-emojis-list
{
    max-height: 360px;
    overflow: auto;
    border: 1px solid var(--set-line, #888);
    margin-bottom: 10px;
    padding: 4px;
}

.server-emoji-row
{
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 4px;
}

.server-emoji-row > span:nth-child(2)
{
    flex: 1;
    overflow-wrap: anywhere;
}

.server-emoji-row > .server-emoji-image
{
    width: 36px;
    flex: 0 0 36px;
    overflow: hidden;
}

.server-emoji-image img
{
    width: 28px;
    height: 28px;
    object-fit: contain;
    vertical-align: middle;
}

.chat-reaction .server-emoji-image img
{
    width: 20px;
    height: 20px;
}

.chat-reaction-picker .server-emoji-image
{
    font-size: 11px;
    overflow-wrap: anywhere;
}

.server-emoji-unicode
{
    font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif;
    font-size: 24px;
    line-height: 1.2;
    vertical-align: middle;
}

.chat-reaction .server-emoji-unicode
{
    font-size: 18px;
}

.chat-reaction-picker .server-emoji-unicode
{
    font-size: 24px;
    overflow-wrap: normal;
}
