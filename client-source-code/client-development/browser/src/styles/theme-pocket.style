}

/* Shared dialog variables keep the newer windows consistent with the theme. */
:root :is(#groups-dialog, #groups-log-dialog, #groups-icon-picker)
{
    --groups-panel: #ffffff;
    --groups-list-background: #f7faf9;
    --groups-title-background: #ffffff;
