    --groups-radius: 14px;
    --groups-frame: 1px solid #c9d8da;
    --groups-option-background: #ffffff;
    --groups-shadow: 0 12px 40px #20363826;
    font-size: 14px;
}

:root :is(#local-settings-container, #groups-dialog, #groups-log-dialog, #groups-icon-picker) :is(button, select, input:not([type="checkbox"]))
{
    min-height: 44px;
