}

:root :is(#server-settings-tab, #groups-dialog, #groups-log-dialog, #groups-icon-picker, #channel-properties-edit, #channel-password-enter, #musicbot-management-dialog, #admin-password-enter, #poke-client-enter, #adjust-volume-card, #set-new-username-enter, #client-info-enter, #identity-string-use-container-enter, #secret-identity-string-container-enter, #android-settings-warning) .close-button.close-button
{
