/* Shared identity dialogs: theme colours, readable fields and consistent actions. */
:root :is(#identity-string-use-container, #secret-identity-string-container)
{
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 401 !important;
}

:root .identity-dialog:is(#identity-string-use-container-enter, #secret-identity-string-container-enter)
{
    box-sizing: border-box;
    width: 480px;
    max-width: calc(100vw - 24px) !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: calc(100dvh - 24px) !important;
    padding: 0;
    overflow: auto !important;
    overscroll-behavior: contain;
    border: 1px solid var(--set-line, #4a4a4a);
    border-radius: 12px;
    background: var(--set-panel, #36393f);
    color: var(--set-text, #e8e8e8);
    text-align: left;
    white-space: normal;
}

:root .identity-dialog > #menu-bar-container
{
    height: 56px;
    min-height: 56px;
    padding: 0 20px;
}

:root :is(#identity-string-use-container-enter, #secret-identity-string-container-enter).identity-dialog > #menu-bar-container > .dialog-title
{
    padding: 0 36px 0 0;
    font: 600 16px/56px var(--set-font, sans-serif);
    letter-spacing: 0;
}

:root .identity-dialog > #menu-bar-container > .close-button.close-button
{
    top: 10px;
    right: 12px;
    width: 36px;
    height: 36px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--set-muted, #b8bec8);
    transform: none;
    cursor: pointer;
}

:root .identity-dialog > #menu-bar-container > .close-button.close-button::before
{
    content: "\00d7";
    display: block;
    position: static;
    width: auto;
    height: auto;
    border: 0;
    background: none;
    color: inherit;
    font: 24px/36px sans-serif;
    transform: none;
}

:root .identity-dialog .identity-dialog-body
{
    display: grid;
    gap: 18px;
    padding: 20px;
}

:root .identity-dialog .identity-dialog-explainer
{
    margin: 0;
    padding: 0;
    color: var(--set-text, #e8e8e8);
    font: 14px/1.5 var(--set-font, sans-serif);
}

:root .identity-dialog .identity-dialog-label
{
    display: block;
    margin: 0 0 8px;
    padding: 0;
    color: var(--set-text, #e8e8e8);
    font: 600 14px/1.5 var(--set-font, sans-serif);
}

:root .identity-dialog .identity-dialog-hint
{
    display: block;
    min-height: 0;
    margin: 0;
    padding: 0;
    color: var(--set-muted, #b8bec8);
    font: 13px/1.5 var(--set-font, sans-serif);
    overflow-wrap: anywhere;
}

:root .identity-dialog .identity-file-picker
{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 112px;
    box-sizing: border-box;
    padding: 16px;
    border: 1px dashed var(--set-line, #646a74);
    border-radius: 8px;
    text-align: center;
}

:root .identity-dialog :is(#identity-string-use-textarea, #p-secret-identity-string)
{
    display: block;
    position: static;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    height: 112px;
    min-height: 112px;
    margin: 0;
    padding: 12px;
    resize: vertical;
    border: 1px solid var(--set-line, #646a74);
    border-radius: 8px;
    background: var(--set-input, var(--set-panel-2, var(--set-panel, #292c31)));
    color: var(--set-text, #e8e8e8);
    font: 13px/1.6 ui-monospace, Consolas, monospace;
    text-align: left;
    overflow-wrap: anywhere;
    word-break: break-all;
    white-space: pre-wrap;
    user-select: text;
    -webkit-user-select: text;
}

:root .identity-dialog #identity-string-use-textarea::placeholder
{
    color: var(--set-muted, #b8bec8);
    font: 14px/1.5 var(--set-font, sans-serif);
    opacity: 1;
}

:root .identity-dialog :is(#identity-file-status, #identity-passphrase-hint, #identity-export-hint)
{
    margin-top: 10px;
    min-height: 20px;
}

:root .identity-dialog .identity-dialog-actions
{
    display: flex;
    justify-content: flex-end;
    margin-top: 16px;
}

:root .identity-dialog .identity-dialog-button-row
{
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    align-items: center;
    margin: 0;
    padding: 0;
}

:root .identity-dialog .button-1
{
    position: static;
    box-sizing: border-box;
    width: auto;
    height: auto;
    min-height: 44px;
    margin: 0;
    padding: 10px 16px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--phone-accent, var(--set-accent, #5865f2));
    color: var(--phone-accent-text, var(--set-accent-text, #ffffff));
    font: 600 14px/20px var(--set-font, sans-serif);
    box-shadow: none;
    cursor: pointer;
}

:root .identity-dialog .button-1:hover:not(:disabled)
{
    filter: brightness(1.08);
}

:root .identity-dialog .button-1:disabled
{
    opacity: 0.45;
    cursor: default;
}

:root .identity-dialog .identity-dialog-note
{
    border-top: 1px solid var(--set-line, #4a4a4a);
    padding-top: 16px;
}

:root .identity-dialog .identity-dialog-link
{
    display: block;
    width: fit-content;
    min-height: 36px;
    margin: -6px 0 0;
    padding: 6px 0;
    border: 0;
    background: transparent;
    color: var(--set-text, #e8e8e8);
    font: 600 14px/24px var(--set-font, sans-serif);
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
}

:root .identity-dialog :is(button, input, textarea):focus-visible
{
    outline: 2px solid var(--set-accent, #7d9aff);
    outline-offset: 3px;
}

:root .identity-dialog .identity-dialog-help
{
    border-top: 1px solid var(--set-line, #4a4a4a);
    padding-top: 16px;
    color: var(--set-muted, #b8bec8);
    font: 13px/1.6 var(--set-font, sans-serif);
}

:root .identity-dialog .identity-dialog-help > summary
{
    color: var(--set-text, #e8e8e8);
    font-weight: 600;
    cursor: pointer;
}

:root .identity-dialog .identity-dialog-help > summary:focus-visible
{
    outline: 2px solid var(--set-accent, #7d9aff);
    outline-offset: 3px;
}

:root .identity-dialog .identity-dialog-help > p
{
    margin: 12px 0 0;
    color: inherit;
    font: inherit;
}

@media (max-width: 420px)
{
    :root .identity-dialog #p-secret-identity-string
    {
        height: 176px;
    }

    :root .identity-dialog .identity-dialog-body
    {
        padding: 16px;
    }

    :root .identity-dialog .identity-dialog-actions > .button-1
    {
        width: 100%;
    }
}
