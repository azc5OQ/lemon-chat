/* Palette only: Mono Light and Mono Dark use the same layout. */
:root
{
    color-scheme: dark;
    --mono-bg: #09090b;
    --mono-surface: #19191c;
    --mono-text: #f2f2f3;
    --mono-muted: #a0a0a9;
    --mono-line: #303036;
    --mono-inverse: #101013;
    --mono-accent: #8bacff;
    --mono-icon-filter: invert(1);
    --tabs-appearance-icon: var(--tabs-appearance-light);
    --tabs-settings-icon: var(--tabs-settings-light);
    --mono-glass-fill: linear-gradient(145deg, #393e48, #1b1e25 60%, #292e38);
    --mono-glass-rim: rgba(147, 160, 184, 0.35);
    --mono-glass-sheen: linear-gradient(145deg, rgba(255, 255, 255, 0.19), rgba(255, 255, 255, 0.035) 44%, transparent 64%);
    --mono-glass-shadow: 0 4px 10px rgba(0, 0, 0, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.25), inset 0 -2px 3px rgba(0, 0, 0, 0.3);
    --phone-microphone-icon: var(--phone-microphone-dark);
    --phone-send-icon: var(--phone-send-dark);
}
